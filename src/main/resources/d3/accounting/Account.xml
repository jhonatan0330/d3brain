<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="d3.accounting.infrastructure.AccountMapper">

	<sql id="selectAccountFragment">
		select
			ccue_llave as key
			,ccue_catalogo as catalog
			,ccue_wbs as wbs
			,ccue_nombre as name
			,ccue_codigo as code
			,ccue_padre as parent
			,ncue_nivel as level
			,ccue_tipo as type
			,ccue_naturaleza as operation
			,ccue_plantilla as template
			,ccue_campo as field
			,ccue_documento as document
			,ccue_estado as state
		from account.cuenta_cue a
	</sql>

	<sql id="whereAccountFragment">
		where 1=1<if test="key!=null">
		and ccue_llave = #{key}</if><if test="state!=null">
		and ccue_estado = #{state}</if>
<if test="catalog!=null">		and ccue_catalogo = #{catalog}</if>
<if test="wbs!=null">		and ccue_wbs = #{wbs}</if>
<if test="name!=null">		and ccue_nombre = #{name}</if>
<if test="code!=null">		and ccue_codigo = #{code}</if>
<if test="parent!=null">		and ccue_padre = #{parent}</if>
<if test="level!=null">		and ncue_nivel = #{level}</if>
<if test="type!=null">		and ccue_tipo = #{type}</if>
<if test="operation!=null">		and ccue_naturaleza = #{operation}</if>
<if test="template!=null">		and ccue_plantilla = #{template}</if>
<if test="field!=null">		and ccue_campo = #{field}</if>
<if test="document!=null">		and ccue_documento = #{document}</if>
<if test="filter!=null">		and (upper(ccue_nombre) like upper('%' || #{filter} || '%') or upper(ccue_codigo) like upper('%' || #{filter} || '%'))</if>
	</sql>

	<sql id="paginationAccountFragment">
		<if test="startRow!=null">OFFSET #{startRow}</if>
		<if test="endRow!=null">LIMIT #{endRow}</if>
	</sql>

	<sql id="whereAccountPrimaryKeyFragment">
		where ccue_llave =#{key}
	</sql>

	<select id="getOne" parameterType="AccountFilterDTO" resultType="AccountDTO">
		<include refid="selectAccountFragment" />
		<include refid="whereAccountFragment" />
		LIMIT 2
	</select>
	
	<select id="getMany" parameterType="AccountFilterDTO" resultType="AccountDTO">
		<include refid="selectAccountFragment" />
		<include refid="whereAccountFragment" />
		order by ccue_wbs 
		<include refid="paginationAccountFragment" />
	</select>

	<select id="count" parameterType="AccountFilterDTO" resultType="int">
		select count(*)
		from account.cuenta_cue
		<include refid="whereAccountFragment" />
	</select>

	<select id="insert" parameterType="AccountDTO" resultType="AccountDTO">
		insert into account.cuenta_cue(ccue_llave
		<if test="catalog!=null">,ccue_catalogo</if>
		<if test="wbs!=null">,ccue_wbs</if>
		<if test="name!=null">,ccue_nombre</if>
		<if test="code!=null">,ccue_codigo</if>
		<if test="parent!=null">,ccue_padre</if>
		<if test="level!=null">,ncue_nivel</if>
		<if test="type!=null">,ccue_tipo</if>
		<if test="operation!=null">,ccue_naturaleza</if>
		<if test="template!=null">,ccue_plantilla</if>
		<if test="field!=null">,ccue_campo</if>
		<if test="document!=null">,ccue_documento</if>
		<if test="state!=null">,ccue_estado</if>
		) values (#{key}
		<if test="catalog!=null">,#{catalog}</if>
		<if test="wbs!=null">,#{wbs}</if>
		<if test="name!=null">,#{name}</if>
		<if test="code!=null">,#{code}</if>
		<if test="parent!=null">,#{parent}</if>
		<if test="level!=null">,#{level}</if>
		<if test="type!=null">,#{type}</if>
		<if test="operation!=null">,#{operation}</if>
		<if test="template!=null">,#{template}</if>
		<if test="field!=null">,#{field}</if>
		<if test="document!=null">,#{document}</if>
		<if test="state!=null">,#{state}</if>
		)
	</select>

	<select id="update" parameterType="AccountDTO" resultType="AccountDTO">
		update account.cuenta_cue
		set
		ccue_catalogo = #{catalog},
		ccue_wbs = #{wbs},
		ccue_nombre = #{name},
		ccue_codigo = #{code},
		ccue_padre = #{parent},
		ncue_nivel = #{level},
		ccue_tipo = #{type},
		ccue_naturaleza = #{operation},
		ccue_plantilla = #{template},
		ccue_campo = #{field},
		ccue_documento = #{document},
		ccue_estado =#{state}
		<include refid="whereAccountPrimaryKeyFragment" />
	</select>
	
</mapper>