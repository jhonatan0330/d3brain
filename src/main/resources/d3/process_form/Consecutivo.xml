<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="d3.process_form.infrastructure.ConsecutivoMapper">

	<sql id="selectConsecutivoFragment">
		select
			ccon_llave as  llaveTabla
			,ccon_nombre as  nombre
			,ccon_prefijo as  prefijo
			,ccon_sufijo as  sufijo
			,mcon_numeroinicial as  numeroInicial
			,mcon_numerofinal as  numeroFinal
			,mcon_numeroactual as  numeroActual
			,bcon_manual as  manual
			,ccon_padding as  padding
			,ccon_estado as estado
		from consecutivo_conp a
	</sql>

	<sql id="whereConsecutivoFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and ccon_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and ccon_estado = #{estado}
			</if>
			<if test="nombre!=null">
				and ccon_nombre = #{nombre}
			</if>
			<if test="prefijo!=null">
				and ccon_prefijo = #{prefijo}
			</if>
			<if test="sufijo!=null">
				and ccon_sufijo = #{sufijo}
			</if>
			<if test="manualFilter!=null">
				and bcon_manual = #{manualFilter}
			</if>
			<if test="padding!=null">
				and ccon_padding = #{padding}
			</if>
			<if test="filtroParametro!=null">
				and (upper(ccon_nombre) like upper('%' || #{filtroParametro} || '%') or upper(ccon_prefijo) like upper('%' || #{filtroParametro} || '%'))
			</if>
	</sql>

	<sql id="paginationConsecutivoFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="whereConsecutivoPrimaryKeyFragment">
		where
			ccon_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="ConsecutivoDTO" resultType="ConsecutivoDTO">
		<include refid="selectConsecutivoFragment" />
		<include refid="whereConsecutivoFragment" />
	</select>
	
	<select id="listar" parameterType="ConsecutivoDTO" resultType="ConsecutivoDTO">
		<include refid="selectConsecutivoFragment" />
		<include refid="whereConsecutivoFragment" />
		order by ccon_nombre 
		<include refid="paginationConsecutivoFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="ConsecutivoDTO" resultType="int">
		select count(*)
		from consecutivo_conp
		<include refid="whereConsecutivoFragment" />
	</select>


	<select id="insertar" parameterType="ConsecutivoDTO" resultType="ConsecutivoDTO">
		insert into consecutivo_conp(
			ccon_llave
		<if test="nombre!=null">
			,ccon_nombre
		</if>
		<if test="prefijo!=null">
			,ccon_prefijo
		</if>
		<if test="sufijo!=null">
			,ccon_sufijo
		</if>
		<if test="numeroInicial!=null">
			,mcon_numeroinicial
		</if>
		<if test="numeroFinal!=null">
			,mcon_numerofinal
		</if>
		<if test="numeroActual!=null">
			,mcon_numeroactual
		</if>
		<if test="manual!=null">
			,bcon_manual
		</if>
		<if test="padding!=null">
			,ccon_padding
		</if>
		<if test="estado!=null">
			,ccon_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="nombre!=null">
			,#{nombre}
		</if>
		<if test="prefijo!=null">
			,#{prefijo}
		</if>
		<if test="sufijo!=null">
			,#{sufijo}
		</if>
		<if test="numeroInicial!=null">
			,#{numeroInicial}
		</if>
		<if test="numeroFinal!=null">
			,#{numeroFinal}
		</if>
		<if test="numeroActual!=null">
			,#{numeroActual}
		</if>
		<if test="manual!=null">
			,#{manual}
		</if>
		<if test="padding!=null">
			,#{padding}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="ConsecutivoDTO" resultType="ConsecutivoDTO">
		update consecutivo_conp
			set
				ccon_nombre = #{nombre},
				ccon_prefijo = #{prefijo},
				ccon_sufijo = #{sufijo},
				mcon_numeroinicial = #{numeroInicial},
				mcon_numerofinal = #{numeroFinal},
				mcon_numeroactual = #{numeroActual},
				bcon_manual = #{manual},
				ccon_padding = #{padding},
				ccon_estado =#{estado}
		<include refid="whereConsecutivoPrimaryKeyFragment" />
	</select>
	
	<sql id="selectSimpleConsecutivoFragment">
		select
			ccon_llave as  llaveTabla
			,ccon_nombre as  nombre
			,ccon_prefijo as  prefijo
			,ccon_sufijo as  sufijo
			,mcon_numeroinicial as  numeroInicial
			,mcon_numerofinal as  numeroFinal
			,mcon_numeroactual as  numeroActual
			,bcon_manual as  manual
			,ccon_padding as  padding
			,ccon_estado as estado
		from consecutivo_conp a
	</sql>
	
	<select id="consultarSimple" resultType="ConsecutivoDTO">
		<include refid="selectSimpleConsecutivoFragment" />
		<include refid="whereConsecutivoFragment" />
	</select>
	
	<select id="listarSimple" resultType="ConsecutivoDTO">
		<include refid="selectSimpleConsecutivoFragment" />
		<include refid="whereConsecutivoFragment" />
		order by ccon_nombre 
		<include refid="paginationConsecutivoFragment" />
	</select>
	


<!--// BEGIN region script-->
	<select id="obtenerPrefijo" parameterType="java.lang.String" resultType="java.lang.String">
		select cpdv_nombre from pedidoventa_pdvp where cpdv_llave = #{documento}
	</select>
<!--// END region script-->

</mapper>