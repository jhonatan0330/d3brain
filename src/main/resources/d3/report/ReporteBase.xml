<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="d3.report.infrastructure.ReporteBaseMapper">

	<sql id="selectReporteBaseFragment">
		select
			crpb_llave as  llaveTabla
			,crpb_plantilla as  nodoSuperior
			,(select cdpl_nombre from documentoplantilla_dplp where cdpl_llave = crpb_plantilla) as  nodoSuperiorNombre
			,crpb_nombre as  nombre
			,crpb_codigo as  codigo
			,crpb_estado as estado
		from reportebase_rpbp a
	</sql>

	<sql id="whereReporteBaseFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and crpb_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and crpb_estado = #{estado}
			</if>
			<if test="nodoSuperior!=null">
				and crpb_plantilla = #{nodoSuperior}
			</if>
			<if test="nombre!=null">
				and crpb_nombre = #{nombre}
			</if>
			<if test="codigo!=null">
				and crpb_codigo = #{codigo}
			</if>
			<if test="filtroParametro!=null">
				and (upper(crpb_nombre) like upper('%' || #{filtroParametro} || '%'))
			</if>
	</sql>

	<sql id="paginationReporteBaseFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="whereReporteBasePrimaryKeyFragment">
		where
			crpb_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="ReporteBaseDTO" resultType="ReporteBaseDTO">
		<include refid="selectReporteBaseFragment" />
		<include refid="whereReporteBaseFragment" />
	</select>
	
	<select id="listar" parameterType="ReporteBaseDTO" resultType="ReporteBaseDTO">
		<include refid="selectReporteBaseFragment" />
		<include refid="whereReporteBaseFragment" />
		order by nodoSuperiorNombre 
		, crpb_nombre 
		<include refid="paginationReporteBaseFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="ReporteBaseDTO" resultType="int">
		select count(*)
		from reportebase_rpbp
		<include refid="whereReporteBaseFragment" />
	</select>


	<select id="insertar" parameterType="ReporteBaseDTO" resultType="ReporteBaseDTO">
		insert into reportebase_rpbp(
			crpb_llave
		<if test="nodoSuperior!=null">
			,crpb_plantilla
		</if>
		<if test="nombre!=null">
			,crpb_nombre
		</if>
		<if test="codigo!=null">
			,crpb_codigo
		</if>
		
		<if test="estado!=null">
			,crpb_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="nodoSuperior!=null">
			,#{nodoSuperior}
		</if>
		<if test="nombre!=null">
			,#{nombre}
		</if>
		<if test="codigo!=null">
			,#{codigo}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="ReporteBaseDTO" resultType="ReporteBaseDTO">
		update reportebase_rpbp
			set
				crpb_plantilla = #{nodoSuperior},
				crpb_nombre = #{nombre},
				crpb_codigo = #{codigo},
				crpb_estado =#{estado}
		<include refid="whereReporteBasePrimaryKeyFragment" />
	</select>
	

	<select id="listarMenu" resultType="ReporteBaseDTO">
		select
			crpb_llave as  llaveTabla
			,crpb_nombre as  nombre
			,crpb_codigo as  codigo
			,crpb_plantilla as  nodoSuperior
			,crpb_estado as estado
		from reportebase_rpbp a
		where crpb_estado ='A' and crpb_llave not in (select cppd_valor from propiedad_ppdp where cppd_estado = 'A' and cppd_propiedadvalor in ('PROP_72','PROP_70','PROP_100','PROP_137'))
	</select>

</mapper>