		</if>
		<if test="fechaInicio!=null">
			,drej_fechainicio
		</if>
		<if test="fechaFin!=null">
			,drej_fechafin
		</if>
		<if test="error!=null">
			,crej_error
		</if>
		<if test="usuario!=null">
			,crej_usuario
		</if>
		<if test="url!=null">
			,crej_url
		</if>
		<if test="estado!=null">
			,crej_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="reporte!=null">
			,#{reporte}
		</if>
		<if test="documento!=null">
			,#{documento}
		</if>
		<if test="fechaInicio!=null">
			,#{fechaInicio}
		</if>
		<if test="fechaFin!=null">
