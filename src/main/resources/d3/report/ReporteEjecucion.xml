		</if>
		)
	</select>

	<select id="actualizar" parameterType="ReporteEjecucionDTO" resultType="ReporteEjecucionDTO">
		update reporteejecucion_rejp
			set
				crej_reporte = #{reporte},
				crej_documento = #{documento},
				drej_fechainicio = #{fechaInicio},
				drej_fechafin = #{fechaFin},
				crej_error = #{error},
				crej_usuario = #{usuario},
				crej_url = #{url},
				crej_estado =#{estado}
		<include refid="whereReporteEjecucionPrimaryKeyFragment" />
	</select>

</mapper>