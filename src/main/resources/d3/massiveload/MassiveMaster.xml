<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="d3.massiveload.infrastructure.MassiveMasterMapper">

	<sql id="selectMassiveMasterFragment">
		select
			ccmv_llave as  key
			,dcmv_fecha as  fecha
			,ccmv_usuario as  usuario
			,ccmv_archivo as  archivo
			,ccmv_estado as state
			,ccmv_mensaje as mensaje
			,ccmv_plantilla as plantilla
			,ccmv_progreso as progreso
		from cargamasiva_cmvp a
	</sql>

	<sql id="whereMassiveMasterFragment">
		where 1=1
			<if test="key!=null">
				and ccmv_llave = #{key}
			</if>
			<if test="state!=null">
				and ccmv_estado = #{state}
			</if>
			<if test="fechaMin!=null">
				and dcmv_fecha >= #{fechaMin}
			</if>
			<if test="fechaMax!=null">
				and dcmv_fecha <![CDATA[ < ]]>  #{fechaMax}
			</if>
			<if test="usuario!=null">
				and ccmv_usuario = #{usuario}
			</if>
			<if test="plantilla!=null">
				and ccmv_plantilla = #{plantilla}
			</if>
			<if test="mensaje!=null">
				and ccmv_mensaje = #{mensaje}
			</if>
			<if test="progreso!=null">
				and ccmv_progreso = #{progreso}
			</if>
	</sql>

	<sql id="paginationMassiveMasterFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="whereMassiveMasterPrimaryKeyFragment">
		where
			ccmv_llave	=#{key}
	</sql>

	<select id="selectOne" parameterType="MassiveMasterFilter" resultType="MassiveMasterDTO">
		<include refid="selectMassiveMasterFragment" />
		<include refid="whereMassiveMasterFragment" />
	</select>
	
	<select id="selectMany" parameterType="MassiveMasterFilter" resultType="MassiveMasterDTO">
		<include refid="selectMassiveMasterFragment" />
		<include refid="whereMassiveMasterFragment" />
		<include refid="paginationMassiveMasterFragment" />
	</select>

	<select id="count" parameterType="MassiveMasterFilter" resultType="int">
		select count(*)
		from cargamasiva_cmvp
		<include refid="whereMassiveMasterFragment" />
	</select>


	<select id="insert" parameterType="MassiveMasterDTO">
		insert into cargamasiva_cmvp(
			ccmv_llave
		<if test="fecha!=null">
			,dcmv_fecha
		</if>
		<if test="usuario!=null">
			,ccmv_usuario
		</if>
		<if test="archivo!=null">
			,ccmv_archivo
		</if>
		<if test="state!=null">
			,ccmv_estado
		</if>
		<if test="mensaje!=null">
			,ccmv_mensaje
		</if>
		<if test="plantilla!=null">
			,ccmv_plantilla
		</if>
		<if test="progreso!=null">
			,ccmv_progreso
		</if>
		) values (
			#{key}
		<if test="fecha!=null">
			,#{fecha}
		</if>
		<if test="usuario!=null">
			,#{usuario}
		</if>
		<if test="archivo!=null">
			,#{archivo}
		</if>
		<if test="state!=null">
			,#{state}
		</if>
		<if test="mensaje!=null">
			,#{mensaje}
		</if>
		<if test="plantilla!=null">
			,#{plantilla}
		</if>
		<if test="progreso!=null">
			,#{progreso}
		</if>
		)
	</select>

	<select id="update" parameterType="MassiveMasterDTO">
		update cargamasiva_cmvp
			set
				dcmv_fecha = #{fecha},
				ccmv_usuario = #{usuario},
				ccmv_archivo = #{archivo},
				ccmv_estado =#{state},
				ccmv_mensaje = #{mensaje},
				ccmv_plantilla = #{plantilla},
				ccmv_progreso = #{progreso}
		<include refid="whereMassiveMasterPrimaryKeyFragment" />
	</select>
	
	<sql id="selectSimpleMassiveMasterFragment">
		select
			ccmv_llave as  key
			,dcmv_fecha as  fecha
			,ccmv_usuario as  usuario
			,ccmv_archivo as  archivo
			,ccmv_estado as state
			,ccmv_mensaje as mensaje
			,ccmv_plantilla as plantilla
			,ccmv_progreso as progreso
		from cargamasiva_cmvp a
	</sql>
	
	<select id="consultarSimple" resultType="MassiveMasterDTO">
		<include refid="selectSimpleMassiveMasterFragment" />
		<include refid="whereMassiveMasterFragment" />
	</select>
	
	<select id="listarSimple" resultType="MassiveMasterDTO">
		<include refid="selectSimpleMassiveMasterFragment" />
		<include refid="whereMassiveMasterFragment" />
		<include refid="paginationMassiveMasterFragment" />
	</select>
	

</mapper>