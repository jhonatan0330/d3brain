<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.softure.mail.infrastructure.MensajePlantillaCorreoMapper">

	<sql id="selectMensajePlantillaCorreoFragment">
		select
			cmpl_llave as  llaveTabla
			,cmpl_nombre as  nombre
			,cmpl_titulo as  titulo
			,cmpl_texto as  texto
			,cmpl_servidor as  servidor
			,cmpl_estado as estado
		from mensajeplantillacorreo_mplp a
	</sql>

	<sql id="whereMensajePlantillaCorreoFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and cmpl_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and cmpl_estado = #{estado}
			</if>
			<if test="nombre!=null">
				and cmpl_nombre = #{nombre}
			</if>
			<if test="servidor!=null">
				and cmpl_servidor = #{servidor}
			</if>
	</sql>

	<sql id="paginationMensajePlantillaCorreoFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="whereMensajePlantillaCorreoPrimaryKeyFragment">
		where
			cmpl_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="MensajePlantillaCorreoDTO" resultType="MensajePlantillaCorreoDTO">
		<include refid="selectMensajePlantillaCorreoFragment" />
		<include refid="whereMensajePlantillaCorreoFragment" />
	</select>
	
	<select id="listar" parameterType="MensajePlantillaCorreoDTO" resultType="MensajePlantillaCorreoDTO">
		<include refid="selectMensajePlantillaCorreoFragment" />
		<include refid="whereMensajePlantillaCorreoFragment" />
		order by cmpl_nombre 
		<include refid="paginationMensajePlantillaCorreoFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="MensajePlantillaCorreoDTO" resultType="int">
		select count(*)
		from mensajeplantillacorreo_mplp
		<include refid="whereMensajePlantillaCorreoFragment" />
	</select>


	<select id="insertar" parameterType="MensajePlantillaCorreoDTO" resultType="MensajePlantillaCorreoDTO">
		insert into mensajeplantillacorreo_mplp(
			cmpl_llave
		<if test="nombre!=null">
			,cmpl_nombre
		</if>
		<if test="titulo!=null">
			,cmpl_titulo
		</if>
		<if test="texto!=null">
			,cmpl_texto
		</if>
		<if test="servidor!=null">
			,cmpl_servidor
		</if>
		<if test="estado!=null">
			,cmpl_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="nombre!=null">
			,#{nombre}
		</if>
		<if test="titulo!=null">
			,#{titulo}
		</if>
		<if test="texto!=null">
			,#{texto}
		</if>
		<if test="servidor!=null">
			,#{servidor}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="MensajePlantillaCorreoDTO" resultType="MensajePlantillaCorreoDTO">
		update mensajeplantillacorreo_mplp
			set
				cmpl_nombre = #{nombre},
				cmpl_titulo = #{titulo},
				cmpl_texto = #{texto},
				cmpl_servidor = #{servidor},
				cmpl_estado =#{estado}
		<include refid="whereMensajePlantillaCorreoPrimaryKeyFragment" />
	</select>
	
	<sql id="selectSimpleMensajePlantillaCorreoFragment">
		select
			cmpl_llave as  llaveTabla
			,cmpl_nombre as  nombre
			,cmpl_titulo as  titulo
			,cmpl_texto as  texto
			,cmpl_servidor as  servidor
			,cmpl_estado as estado
		from mensajeplantillacorreo_mplp a
	</sql>
	
	<select id="consultarSimple" resultType="MensajePlantillaCorreoDTO">
		<include refid="selectSimpleMensajePlantillaCorreoFragment" />
		<include refid="whereMensajePlantillaCorreoFragment" />
	</select>
	
	<select id="listarSimple" resultType="MensajePlantillaCorreoDTO">
		<include refid="selectSimpleMensajePlantillaCorreoFragment" />
		<include refid="whereMensajePlantillaCorreoFragment" />
		order by cmpl_nombre 
		<include refid="paginationMensajePlantillaCorreoFragment" />
	</select>
	
	<select id="getFullToSynchronize" resultType="MensajePlantillaCorreoDTO">
		<include refid="selectSimpleMensajePlantillaCorreoFragment" />
		where cmpl_estado = 'A'
	</select>

<!--// BEGIN region script-->
<!--// END region script-->

</mapper>