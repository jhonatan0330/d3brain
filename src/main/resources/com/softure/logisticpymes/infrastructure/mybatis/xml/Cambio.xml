<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.softure.logisticpymes.infrastructure.mybatis.mapper.CambioMapper">

	<sql id="selectCambioFragment">
		select
			ccmb_llave as  llaveTabla
			,ccmb_nombre as  nombre
			,ccmb_motivo as  motivo
			,dcmb_fecha as  fecha
			,dcmb_fechaaplicacion as  fechaAplicacion
			,ccmb_sesionactiva as  sesionActiva
			,ccmb_estado as estado
		from cambio_cmbp a
	</sql>

	<sql id="whereCambioFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and ccmb_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and ccmb_estado = #{estado}
			</if>
			<if test="nombre!=null">
				and ccmb_nombre = #{nombre}
			</if>
			<if test="fechaMin!=null">
				and dcmb_fecha >= #{fechaMin}
			</if>
			<if test="fechaMax!=null">
				and dcmb_fecha <![CDATA[ < ]]>  #{fechaMax}
			</if>
			<if test="fechaAplicacionMin!=null">
				and dcmb_fechaaplicacion >= #{fechaAplicacionMin}
			</if>
			<if test="fechaAplicacionMax!=null">
				and dcmb_fechaaplicacion <![CDATA[ < ]]>  #{fechaAplicacionMax}
			</if>
			<if test="sesionActiva!=null">
				and ccmb_sesionactiva = #{sesionActiva}
			</if>
	</sql>

	<sql id="paginationCambioFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="whereCambioPrimaryKeyFragment">
		where
			ccmb_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="CambioDTO" resultType="CambioDTO">
		<include refid="selectCambioFragment" />
		<include refid="whereCambioFragment" />
	</select>
	
	<select id="listar" parameterType="CambioDTO" resultType="CambioDTO">
		<include refid="selectCambioFragment" />
		<include refid="whereCambioFragment" />
		order by dcmb_fecha desc
		<include refid="paginationCambioFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="CambioDTO" resultType="int">
		select count(*)
		from cambio_cmbp
		<include refid="whereCambioFragment" />
	</select>


	<select id="insertar" parameterType="CambioDTO" resultType="CambioDTO">
		insert into cambio_cmbp(
			ccmb_llave
		<if test="nombre!=null">
			,ccmb_nombre
		</if>
		<if test="motivo!=null">
			,ccmb_motivo
		</if>
		<if test="fecha!=null">
			,dcmb_fecha
		</if>
		<if test="fechaAplicacion!=null">
			,dcmb_fechaaplicacion
		</if>
		<if test="sesionActiva!=null">
			,ccmb_sesionactiva
		</if>
		<if test="estado!=null">
			,ccmb_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="nombre!=null">
			,#{nombre}
		</if>
		<if test="motivo!=null">
			,#{motivo}
		</if>
		<if test="fecha!=null">
			,#{fecha}
		</if>
		<if test="fechaAplicacion!=null">
			,#{fechaAplicacion}
		</if>
		<if test="sesionActiva!=null">
			,#{sesionActiva}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="CambioDTO" resultType="CambioDTO">
		update cambio_cmbp
			set
				ccmb_nombre = #{nombre},
				ccmb_motivo = #{motivo},
				dcmb_fecha = #{fecha},
				dcmb_fechaaplicacion = #{fechaAplicacion},
				ccmb_sesionactiva = #{sesionActiva},
				ccmb_estado =#{estado}
		<include refid="whereCambioPrimaryKeyFragment" />
	</select>
	
	<sql id="selectSimpleCambioFragment">
		select
			ccmb_llave as  llaveTabla
			,ccmb_nombre as  nombre
			,ccmb_motivo as  motivo
			,dcmb_fecha as  fecha
			,dcmb_fechaaplicacion as  fechaAplicacion
			,ccmb_sesionactiva as  sesionActiva
			,ccmb_estado as estado
		from cambio_cmbp a
	</sql>
	
	<select id="consultarSimple" resultType="CambioDTO">
		<include refid="selectSimpleCambioFragment" />
		<include refid="whereCambioFragment" />
	</select>
	
	<select id="listarSimple" resultType="CambioDTO">
		<include refid="selectSimpleCambioFragment" />
		<include refid="whereCambioFragment" />
		order by dcmb_fecha desc
		<include refid="paginationCambioFragment" />
	</select>
	


<!--// BEGIN region script-->
<!--// END region script-->

</mapper>