<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.softure.logisticpymes.infrastructure.mybatis.mapper.DocumentoTransaccionMapper">

	<sql id="selectDocumentoTransaccionFragment">
		select
			ctra_llave as  llaveTabla
			,dtra_fecha as  fecha
			,ctra_usuario as  usuario
			,ctra_estado as estado
		from documentotransaccion_trap a
	</sql>

	<sql id="whereDocumentoTransaccionFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and ctra_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and ctra_estado = #{estado}
			</if>
			<if test="fechaMin!=null">
				and dtra_fecha >= #{fechaMin}
			</if>
			<if test="fechaMax!=null">
				and dtra_fecha <![CDATA[ < ]]>  #{fechaMax}
			</if>
			<if test="usuario!=null">
				and ctra_usuario = #{usuario}
			</if>
	</sql>

	<sql id="paginationDocumentoTransaccionFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="whereDocumentoTransaccionPrimaryKeyFragment">
		where
			ctra_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="DocumentoTransaccionDTO" resultType="DocumentoTransaccionDTO">
		<include refid="selectDocumentoTransaccionFragment" />
		<include refid="whereDocumentoTransaccionFragment" />
	</select>
	
	<select id="listar" parameterType="DocumentoTransaccionDTO" resultType="DocumentoTransaccionDTO">
		<include refid="selectDocumentoTransaccionFragment" />
		<include refid="whereDocumentoTransaccionFragment" />
		<include refid="paginationDocumentoTransaccionFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="DocumentoTransaccionDTO" resultType="int">
		select count(*)
		from documentotransaccion_trap
		<include refid="whereDocumentoTransaccionFragment" />
	</select>


	<select id="insertar" parameterType="DocumentoTransaccionDTO" resultType="DocumentoTransaccionDTO">
		insert into documentotransaccion_trap(
			ctra_llave
		<if test="fecha!=null">
			,dtra_fecha
		</if>
		<if test="usuario!=null">
			,ctra_usuario
		</if>
		<if test="estado!=null">
			,ctra_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="fecha!=null">
			,#{fecha}
		</if>
		<if test="usuario!=null">
			,#{usuario}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="DocumentoTransaccionDTO" resultType="DocumentoTransaccionDTO">
		update documentotransaccion_trap
			set
				dtra_fecha = #{fecha},
				ctra_usuario = #{usuario},
				ctra_estado =#{estado}
		<include refid="whereDocumentoTransaccionPrimaryKeyFragment" />
	</select>
	
	<sql id="selectSimpleDocumentoTransaccionFragment">
		select
			ctra_llave as  llaveTabla
			,dtra_fecha as  fecha
			,ctra_usuario as  usuario
			,ctra_estado as estado
		from documentotransaccion_trap a
	</sql>
	
	<select id="consultarSimple" resultType="DocumentoTransaccionDTO">
		<include refid="selectSimpleDocumentoTransaccionFragment" />
		<include refid="whereDocumentoTransaccionFragment" />
	</select>
	
	<select id="listarSimple" resultType="DocumentoTransaccionDTO">
		<include refid="selectSimpleDocumentoTransaccionFragment" />
		<include refid="whereDocumentoTransaccionFragment" />
		<include refid="paginationDocumentoTransaccionFragment" />
	</select>
	


<!--// BEGIN region script-->
<!--// END region script-->

</mapper>