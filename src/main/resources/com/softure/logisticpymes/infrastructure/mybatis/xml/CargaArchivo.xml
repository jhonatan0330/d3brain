<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.softure.logisticpymes.infrastructure.mybatis.mapper.CargaArchivoMapper">

	<sql id="selectCargaArchivoFragment">
		select
			ccar_llave as  llaveTabla
			,ccar_servidor as  servidor
			,ncar_size as  size
			,ccar_url as  url
			,dcar_fechainicio as  fechaInicio
			,dcar_fechafin as  fechaFin
			,ccar_error as  error
			,ccar_usuario as  usuario
			,ccar_estado as estado
		from cargaarchivo_carp a
	</sql>

	<sql id="whereCargaArchivoFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and ccar_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and ccar_estado = #{estado}
			</if>
			<if test="servidor!=null">
				and ccar_servidor = #{servidor}
			</if>
			<if test="fechaInicioMin!=null">
				and dcar_fechainicio >= #{fechaInicioMin}
			</if>
			<if test="fechaInicioMax!=null">
				and dcar_fechainicio <![CDATA[ < ]]>  #{fechaInicioMax}
			</if>
			<if test="fechaFinMin!=null">
				and dcar_fechafin >= #{fechaFinMin}
			</if>
			<if test="fechaFinMax!=null">
				and dcar_fechafin <![CDATA[ < ]]>  #{fechaFinMax}
			</if>
			<if test="usuario!=null">
				and ccar_usuario = #{usuario}
			</if>
	</sql>

	<sql id="paginationCargaArchivoFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="whereCargaArchivoPrimaryKeyFragment">
		where
			ccar_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="CargaArchivoDTO" resultType="CargaArchivoDTO">
		<include refid="selectCargaArchivoFragment" />
		<include refid="whereCargaArchivoFragment" />
	</select>
	
	<select id="listar" parameterType="CargaArchivoDTO" resultType="CargaArchivoDTO">
		<include refid="selectCargaArchivoFragment" />
		<include refid="whereCargaArchivoFragment" />
		<include refid="paginationCargaArchivoFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="CargaArchivoDTO" resultType="int">
		select count(*)
		from cargaarchivo_carp
		<include refid="whereCargaArchivoFragment" />
	</select>


	<select id="insertar" parameterType="CargaArchivoDTO" resultType="CargaArchivoDTO">
		insert into cargaarchivo_carp(
			ccar_llave
		<if test="servidor!=null">
			,ccar_servidor
		</if>
		<if test="size!=null">
			,ncar_size
		</if>
		<if test="url!=null">
			,ccar_url
		</if>
		<if test="fechaInicio!=null">
			,dcar_fechainicio
		</if>
		<if test="fechaFin!=null">
			,dcar_fechafin
		</if>
		<if test="error!=null">
			,ccar_error
		</if>
		<if test="usuario!=null">
			,ccar_usuario
		</if>
		<if test="estado!=null">
			,ccar_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="servidor!=null">
			,#{servidor}
		</if>
		<if test="size!=null">
			,#{size}
		</if>
		<if test="url!=null">
			,#{url}
		</if>
		<if test="fechaInicio!=null">
			,#{fechaInicio}
		</if>
		<if test="fechaFin!=null">
			,#{fechaFin}
		</if>
		<if test="error!=null">
			,#{error}
		</if>
		<if test="usuario!=null">
			,#{usuario}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="CargaArchivoDTO" resultType="CargaArchivoDTO">
		update cargaarchivo_carp
			set
				ccar_servidor = #{servidor},
				ncar_size = #{size},
				ccar_url = #{url},
				dcar_fechainicio = #{fechaInicio},
				dcar_fechafin = #{fechaFin},
				ccar_error = #{error},
				ccar_usuario = #{usuario},
				ccar_estado =#{estado}
		<include refid="whereCargaArchivoPrimaryKeyFragment" />
	</select>
	
	<sql id="selectSimpleCargaArchivoFragment">
		select
			ccar_llave as  llaveTabla
			,ccar_servidor as  servidor
			,ncar_size as  size
			,ccar_url as  url
			,dcar_fechainicio as  fechaInicio
			,dcar_fechafin as  fechaFin
			,ccar_error as  error
			,ccar_usuario as  usuario
			,ccar_estado as estado
		from cargaarchivo_carp a
	</sql>
	
	<select id="consultarSimple" resultType="CargaArchivoDTO">
		<include refid="selectSimpleCargaArchivoFragment" />
		<include refid="whereCargaArchivoFragment" />
	</select>
	
	<select id="listarSimple" resultType="CargaArchivoDTO">
		<include refid="selectSimpleCargaArchivoFragment" />
		<include refid="whereCargaArchivoFragment" />
		<include refid="paginationCargaArchivoFragment" />
	</select>
	


<!--// BEGIN region script-->
<!--// END region script-->

</mapper>