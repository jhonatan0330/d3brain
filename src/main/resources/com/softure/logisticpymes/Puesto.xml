<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.softure.logisticpymes.infrastructure.PuestoMapper">

	<sql id="selectPuestoFragment">
		select
			cpue_llave as  llaveTabla
			,cpue_campo as  campo
			,npue_fila as  fila
			,npue_columna as  columna
			,cpue_imagen as  imagen
			,cpue_nombre as  nombre
			,cpue_estado as estado
		from puesto_puep a
	</sql>

	<sql id="wherePuestoFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and cpue_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and cpue_estado = #{estado}
			</if>
			<if test="campo!=null">
				and cpue_campo = #{campo}
			</if>
			<if test="nombre!=null">
				and cpue_nombre = #{nombre}
			</if>
	</sql>

	<sql id="paginationPuestoFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="wherePuestoPrimaryKeyFragment">
		where
			cpue_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="PuestoDTO" resultType="PuestoDTO">
		<include refid="selectPuestoFragment" />
		<include refid="wherePuestoFragment" />
	</select>
	
	<select id="listar" parameterType="PuestoDTO" resultType="PuestoDTO">
		<include refid="selectPuestoFragment" />
		<include refid="wherePuestoFragment" />
		order by npue_fila 
		, npue_columna 
		<include refid="paginationPuestoFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="PuestoDTO" resultType="int">
		select count(*)
		from puesto_puep
		<include refid="wherePuestoFragment" />
	</select>


	<select id="insertar" parameterType="PuestoDTO" resultType="PuestoDTO">
		insert into puesto_puep(
			cpue_llave
		<if test="campo!=null">
			,cpue_campo
		</if>
		<if test="fila!=null">
			,npue_fila
		</if>
		<if test="columna!=null">
			,npue_columna
		</if>
		<if test="imagen!=null">
			,cpue_imagen
		</if>
		<if test="nombre!=null">
			,cpue_nombre
		</if>
		<if test="estado!=null">
			,cpue_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="campo!=null">
			,#{campo}
		</if>
		<if test="fila!=null">
			,#{fila}
		</if>
		<if test="columna!=null">
			,#{columna}
		</if>
		<if test="imagen!=null">
			,#{imagen}
		</if>
		<if test="nombre!=null">
			,#{nombre}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="PuestoDTO" resultType="PuestoDTO">
		update puesto_puep
			set
				cpue_campo = #{campo},
				npue_fila = #{fila},
				npue_columna = #{columna},
				cpue_imagen = #{imagen},
				cpue_nombre = #{nombre},
				cpue_estado =#{estado}
		<include refid="wherePuestoPrimaryKeyFragment" />
	</select>
	
	<sql id="selectSimplePuestoFragment">
		select
			cpue_llave as  llaveTabla
			,cpue_campo as  campo
			,npue_fila as  fila
			,npue_columna as  columna
			,cpue_imagen as  imagen
			,cpue_nombre as  nombre
			,cpue_estado as estado
		from puesto_puep a
	</sql>
	
	<select id="consultarSimple" resultType="PuestoDTO">
		<include refid="selectSimplePuestoFragment" />
		<include refid="wherePuestoFragment" />
	</select>
	
	<select id="listarSimple" resultType="PuestoDTO">
		<include refid="selectSimplePuestoFragment" />
		<include refid="wherePuestoFragment" />
		order by npue_fila 
		, npue_columna 
		<include refid="paginationPuestoFragment" />
	</select>
	


<!--// BEGIN region script-->
<!--// END region script-->

</mapper>