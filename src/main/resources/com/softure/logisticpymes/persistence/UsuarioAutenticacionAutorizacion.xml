		</if>
		<if test="ipSolicitud!=null">
			,#{ipSolicitud}
		</if>
		<if test="codigo!=null">
			,#{codigo}
		</if>
		<if test="fechaRedencion!=null">
			,#{fechaRedencion}
		</if>
		<if test="key!=null">
			,#{key}
		</if>
		<if test="ipRedencion!=null">
			,#{ipRedencion}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="UsuarioAutenticacionAutorizacionDTO" resultType="UsuarioAutenticacionAutorizacionDTO">
		update usuarioautenticacionautorizacion_uaap
			set
				cuaa_usuario = #{usuario},
				duaa_fechamaxima = #{fechaMaxima},
				duaa_fechasolicitud = #{fechaSolicitud},
				cuaa_correo = #{correo},
				cuaa_ipsolicitud = #{ipSolicitud},
				cuaa_codigo = #{codigo},
				duaa_fecharedencion = #{fechaRedencion},
				cuaa_key = #{key},
				cuaa_ipredencion = #{ipRedencion},
				cuaa_estado =#{estado}
		<include refid="whereUsuarioAutenticacionAutorizacionPrimaryKeyFragment" />
	</select>
	
	<sql id="selectSimpleUsuarioAutenticacionAutorizacionFragment">
		select
			cuaa_llave as  llaveTabla
			,cuaa_usuario as  usuario
			,duaa_fechamaxima as  fechaMaxima
			,duaa_fechasolicitud as  fechaSolicitud
