<mapper namespace="com.softure.logisticpymes.persistence.UsuarioAutenticacionAutorizacionMapper">

	<sql id="selectUsuarioAutenticacionAutorizacionFragment">
		select
			cuaa_llave as  llaveTabla
			,cuaa_usuario as  usuario
			,duaa_fechamaxima as  fechaMaxima
			,duaa_fechasolicitud as  fechaSolicitud
			,cuaa_correo as  correo
			,cuaa_ipsolicitud as  ipSolicitud
			,cuaa_codigo as  codigo
			,duaa_fecharedencion as  fechaRedencion
			,cuaa_key as  key
			,cuaa_ipredencion as  ipRedencion
			,cuaa_estado as estado
		from usuarioautenticacionautorizacion_uaap a
	</sql>

	<sql id="whereUsuarioAutenticacionAutorizacionFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and cuaa_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and cuaa_estado = #{estado}
			</if>
			<if test="usuario!=null">
				and cuaa_usuario = #{usuario}
			</if>
			<if test="fechaMaximaMin!=null">
				and duaa_fechamaxima >= #{fechaMaximaMin}
			</if>
			<if test="fechaMaximaMax!=null">
				and duaa_fechamaxima <![CDATA[ < ]]>  #{fechaMaximaMax}
			</if>
			<if test="fechaSolicitudMin!=null">
				and duaa_fechasolicitud >= #{fechaSolicitudMin}
			</if>
			<if test="fechaSolicitudMax!=null">
				and duaa_fechasolicitud <![CDATA[ < ]]>  #{fechaSolicitudMax}
			</if>
			<if test="correo!=null">
				and cuaa_correo = #{correo}
			</if>
			<if test="ipSolicitud!=null">
				and cuaa_ipsolicitud = #{ipSolicitud}
			</if>
			<if test="codigo!=null">
				and cuaa_codigo = #{codigo}
			</if>
			<if test="fechaRedencionMin!=null">
				and duaa_fecharedencion >= #{fechaRedencionMin}
			</if>
			<if test="fechaRedencionMax!=null">
				and duaa_fecharedencion <![CDATA[ < ]]>  #{fechaRedencionMax}
			</if>
			<if test="key!=null">
				and cuaa_key = #{key}
			</if>
			<if test="ipRedencion!=null">
				and cuaa_ipredencion = #{ipRedencion}
			</if>
	</sql>

	<sql id="paginationUsuarioAutenticacionAutorizacionFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="whereUsuarioAutenticacionAutorizacionPrimaryKeyFragment">
		where
			cuaa_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="UsuarioAutenticacionAutorizacionDTO" resultType="UsuarioAutenticacionAutorizacionDTO">
		<include refid="selectUsuarioAutenticacionAutorizacionFragment" />
		<include refid="whereUsuarioAutenticacionAutorizacionFragment" />
	</select>
	
	<select id="listar" parameterType="UsuarioAutenticacionAutorizacionDTO" resultType="UsuarioAutenticacionAutorizacionDTO">
		<include refid="selectUsuarioAutenticacionAutorizacionFragment" />
		<include refid="whereUsuarioAutenticacionAutorizacionFragment" />
		<include refid="paginationUsuarioAutenticacionAutorizacionFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="UsuarioAutenticacionAutorizacionDTO" resultType="int">
		select count(*)
		from usuarioautenticacionautorizacion_uaap
		<include refid="whereUsuarioAutenticacionAutorizacionFragment" />
	</select>


	<select id="insertar" parameterType="UsuarioAutenticacionAutorizacionDTO" resultType="UsuarioAutenticacionAutorizacionDTO">
		insert into usuarioautenticacionautorizacion_uaap(
			cuaa_llave
		<if test="usuario!=null">
			,cuaa_usuario
		</if>
		<if test="fechaMaxima!=null">
			,duaa_fechamaxima
		</if>
		<if test="fechaSolicitud!=null">
