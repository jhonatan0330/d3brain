		</if>
		<if test="correo!=null">
			,cuaa_correo
		</if>
		<if test="ipSolicitud!=null">
			,cuaa_ipsolicitud
		</if>
		<if test="codigo!=null">
			,cuaa_codigo
		</if>
		<if test="fechaRedencion!=null">
			,duaa_fecharedencion
		</if>
		<if test="key!=null">
			,cuaa_key
		</if>
		<if test="ipRedencion!=null">
			,cuaa_ipredencion
		</if>
		<if test="estado!=null">
			,cuaa_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="usuario!=null">
			,#{usuario}
		</if>
		<if test="fechaMaxima!=null">
			,#{fechaMaxima}
		</if>
		<if test="fechaSolicitud!=null">
			,#{fechaSolicitud}
		</if>
		<if test="correo!=null">
