<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.softure.logisticpymes.persistence.CuentaAuxiliarPlantillaMapper">

	<sql id="selectCuentaAuxiliarPlantillaFragment">
		select
			ccap_llave as  llaveTabla
			,ccap_cuentaprincipal as  cuentaPrincipal
			,ccap_plantilla as  plantilla
			,ccap_estado as estado
		from cuentaauxiliarplantilla_capp a
	</sql>

	<sql id="whereCuentaAuxiliarPlantillaFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and ccap_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and ccap_estado = #{estado}
			</if>
			<if test="cuentaPrincipal!=null">
				and ccap_cuentaprincipal = #{cuentaPrincipal}
			</if>
			<if test="plantilla!=null">
				and ccap_plantilla = #{plantilla}
			</if>
	</sql>

	<sql id="paginationCuentaAuxiliarPlantillaFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="whereCuentaAuxiliarPlantillaPrimaryKeyFragment">
		where
			ccap_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="CuentaAuxiliarPlantillaDTO" resultType="CuentaAuxiliarPlantillaDTO">
		<include refid="selectCuentaAuxiliarPlantillaFragment" />
		<include refid="whereCuentaAuxiliarPlantillaFragment" />
	</select>
	
	<select id="listar" parameterType="CuentaAuxiliarPlantillaDTO" resultType="CuentaAuxiliarPlantillaDTO">
		<include refid="selectCuentaAuxiliarPlantillaFragment" />
		<include refid="whereCuentaAuxiliarPlantillaFragment" />
		<include refid="paginationCuentaAuxiliarPlantillaFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="CuentaAuxiliarPlantillaDTO" resultType="int">
		select count(*)
		from cuentaauxiliarplantilla_capp
		<include refid="whereCuentaAuxiliarPlantillaFragment" />
	</select>


	<select id="insertar" parameterType="CuentaAuxiliarPlantillaDTO" resultType="CuentaAuxiliarPlantillaDTO">
		insert into cuentaauxiliarplantilla_capp(
			ccap_llave
		<if test="cuentaPrincipal!=null">
			,ccap_cuentaprincipal
		</if>
		<if test="plantilla!=null">
			,ccap_plantilla
		</if>
		<if test="estado!=null">
			,ccap_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="cuentaPrincipal!=null">
			,#{cuentaPrincipal}
		</if>
		<if test="plantilla!=null">
			,#{plantilla}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="CuentaAuxiliarPlantillaDTO" resultType="CuentaAuxiliarPlantillaDTO">
		update cuentaauxiliarplantilla_capp
			set
				ccap_cuentaprincipal = #{cuentaPrincipal},
				ccap_plantilla = #{plantilla},
				ccap_estado =#{estado}
		<include refid="whereCuentaAuxiliarPlantillaPrimaryKeyFragment" />
	</select>


<!--// BEGIN region script-->
<!--// END region script-->

</mapper>