<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.softure.logisticpymes.persistence.PedidoVentaAjusteMapper">

	<sql id="selectPedidoVentaAjusteFragment">
		select
			cpva_llave as  llaveTabla
			,cpva_documento as  documento
			,dpva_fecha as  fecha
			,cpva_estadoinicial as  estadoInicial
			,cpva_estadofinal as  estadoFinal
			,cpva_motivo as  motivo
			,cpva_responsable as  responsable
			,cpva_estado as estado
		from pedidoventaajuste_pvap a
	</sql>

	<sql id="wherePedidoVentaAjusteFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and cpva_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and cpva_estado = #{estado}
			</if>
			<if test="documento!=null">
				and cpva_documento = #{documento}
			</if>
			<if test="fechaMin!=null">
				and dpva_fecha >= #{fechaMin}
			</if>
			<if test="fechaMax!=null">
				and dpva_fecha <![CDATA[ < ]]>  #{fechaMax}
			</if>
			<if test="estadoInicial!=null">
				and cpva_estadoinicial = #{estadoInicial}
			</if>
			<if test="estadoFinal!=null">
				and cpva_estadofinal = #{estadoFinal}
			</if>
			<if test="responsable!=null">
				and cpva_responsable = #{responsable}
			</if>
	</sql>

	<sql id="paginationPedidoVentaAjusteFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="wherePedidoVentaAjustePrimaryKeyFragment">
		where
			cpva_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="PedidoVentaAjusteDTO" resultType="PedidoVentaAjusteDTO">
		<include refid="selectPedidoVentaAjusteFragment" />
		<include refid="wherePedidoVentaAjusteFragment" />
	</select>
	
	<select id="listar" parameterType="PedidoVentaAjusteDTO" resultType="PedidoVentaAjusteDTO">
		<include refid="selectPedidoVentaAjusteFragment" />
		<include refid="wherePedidoVentaAjusteFragment" />
		<include refid="paginationPedidoVentaAjusteFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="PedidoVentaAjusteDTO" resultType="int">
		select count(*)
		from pedidoventaajuste_pvap
		<include refid="wherePedidoVentaAjusteFragment" />
	</select>


	<select id="insertar" parameterType="PedidoVentaAjusteDTO" resultType="PedidoVentaAjusteDTO">
		insert into pedidoventaajuste_pvap(
			cpva_llave
		<if test="documento!=null">
			,cpva_documento
		</if>
		<if test="fecha!=null">
			,dpva_fecha
		</if>
		<if test="estadoInicial!=null">
			,cpva_estadoinicial
		</if>
		<if test="estadoFinal!=null">
			,cpva_estadofinal
		</if>
		<if test="motivo!=null">
			,cpva_motivo
		</if>
		<if test="responsable!=null">
			,cpva_responsable
		</if>
		<if test="estado!=null">
			,cpva_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="documento!=null">
			,#{documento}
		</if>
		<if test="fecha!=null">
			,#{fecha}
		</if>
		<if test="estadoInicial!=null">
			,#{estadoInicial}
		</if>
		<if test="estadoFinal!=null">
			,#{estadoFinal}
		</if>
		<if test="motivo!=null">
			,#{motivo}
		</if>
		<if test="responsable!=null">
			,#{responsable}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="PedidoVentaAjusteDTO" resultType="PedidoVentaAjusteDTO">
		update pedidoventaajuste_pvap
			set
				cpva_documento = #{documento},
				dpva_fecha = #{fecha},
				cpva_estadoinicial = #{estadoInicial},
				cpva_estadofinal = #{estadoFinal},
				cpva_motivo = #{motivo},
				cpva_responsable = #{responsable},
				cpva_estado =#{estado}
		<include refid="wherePedidoVentaAjustePrimaryKeyFragment" />
	</select>


<!--// BEGIN region script-->
<!--// END region script-->

</mapper>