<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.softure.logisticpymes.persistence.PostPreguntaMapper">

	<sql id="selectPostPreguntaFragment">
		select
			cppr_llave as  llaveTabla
			,dppr_fecha as  fecha
			,cppr_autor as  autor
			,(select cusr_imagen from usuario_usrp where cusr_llave = cppr_autor) as  autorImagen
			,(select cusr_nombre from usuario_usrp where cusr_llave = cppr_autor) as  autorNombre
			,cppr_pregunta as  pregunta
			,cppr_keywords as  keywords
			,(select count(*) from postrespuesta_prsp, postcalificacion_pclp where cpcl_respuesta = cprs_llave and cprs_pregunta = cppr_llave) as  calificaciones
			,cppr_estado as estado
		from postpregunta_pprp a
	</sql>

	<sql id="wherePostPreguntaFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and cppr_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and cppr_estado = #{estado}
			</if>
			<if test="fechaMin!=null">
				and dppr_fecha >= #{fechaMin}
			</if>
			<if test="fechaMax!=null">
				and dppr_fecha <![CDATA[ < ]]>  #{fechaMax}
			</if>
			<if test="autor!=null">
				and cppr_autor = #{autor}
			</if>
	</sql>

	<sql id="paginationPostPreguntaFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="wherePostPreguntaPrimaryKeyFragment">
		where
			cppr_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="PostPreguntaDTO" resultType="PostPreguntaDTO">
		<include refid="selectPostPreguntaFragment" />
		<include refid="wherePostPreguntaFragment" />
	</select>
	
	<select id="listar" parameterType="PostPreguntaDTO" resultType="PostPreguntaDTO">
		<include refid="selectPostPreguntaFragment" />
		<include refid="wherePostPreguntaFragment" />
		order by dppr_fecha desc
		<include refid="paginationPostPreguntaFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="PostPreguntaDTO" resultType="int">
		select count(*)
		from postpregunta_pprp
		<include refid="wherePostPreguntaFragment" />
	</select>


	<select id="insertar" parameterType="PostPreguntaDTO" resultType="PostPreguntaDTO">
		insert into postpregunta_pprp(
			cppr_llave
		<if test="fecha!=null">
			,dppr_fecha
		</if>
		<if test="autor!=null">
			,cppr_autor
		</if>
		<if test="pregunta!=null">
			,cppr_pregunta
		</if>
		<if test="keywords!=null">
			,cppr_keywords
		</if>
		<if test="estado!=null">
			,cppr_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="fecha!=null">
			,#{fecha}
		</if>
		<if test="autor!=null">
			,#{autor}
		</if>
		<if test="pregunta!=null">
			,#{pregunta}
		</if>
		<if test="keywords!=null">
			,#{keywords}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="PostPreguntaDTO" resultType="PostPreguntaDTO">
		update postpregunta_pprp
			set
				dppr_fecha = #{fecha},
				cppr_autor = #{autor},
				cppr_pregunta = #{pregunta},
				cppr_keywords = #{keywords},
				cppr_estado =#{estado}
		<include refid="wherePostPreguntaPrimaryKeyFragment" />
	</select>


<!--// BEGIN region script-->
	<select id="listarPreguntasPlantilla" resultType="PostPreguntaDTO">
		<include refid="selectPostPreguntaFragment" />
		where str_normalize(cppr_pregunta) LIKE ANY(ARRAY[<foreach item="item" collection="palabrasClave" separator=",">'%' || #{item} || '%' </foreach>])
		order by dppr_fecha desc
		<if test="dto.paginacionRegistroFinal!=null">LIMIT #{dto.paginacionRegistroFinal}</if>
		<if test="dto.paginacionRegistroInicial!=null">OFFSET #{dto.paginacionRegistroInicial}</if>
	</select>
	
	<select id="listarPreguntasSinRespuesta" parameterType="PostPreguntaDTO" resultType="PostPreguntaDTO">
		<include refid="selectPostPreguntaFragment" />
		where cppr_llave not in (select cprs_pregunta from postrespuesta_prsp where cprs_estado = 'A')
		order by dppr_fecha desc
		<include refid="paginationPostPreguntaFragment" />
	</select>
<!--// END region script-->

</mapper>