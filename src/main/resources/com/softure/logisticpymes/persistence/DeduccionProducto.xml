<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.softure.logisticpymes.persistence.DeduccionProductoMapper">

	<sql id="selectDeduccionProductoFragment">
		select
			cdpr_llave as  llaveTabla
			,cdpr_documento as  documento
			,cdpr_producto as  producto
			,(select movimiento_descripcion(cpro_documento) from producto_prop where cpro_llave = cdpr_producto) as  productoNombre
			,(select cpdv_nombre from pedidoventa_pdvp where cpdv_llave = (select cpro_documento from producto_prop where cpro_llave = cdpr_producto)) as  productoCodigo
			,ddpr_fecha as  fecha
			,mdpr_cantidad as  cantidad
			,cdpr_responsable as  responsable
			,(select cusr_nombre from usuario_usrp where cusr_llave =  cdpr_responsable) as  responsableNombre
			,cdpr_bodega as  bodega
			,cdpr_estado as estado
		from deduccionproducto_dprp a
	</sql>

	<sql id="whereDeduccionProductoFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and cdpr_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and cdpr_estado = #{estado}
			</if>
			<if test="documento!=null">
				and cdpr_documento = #{documento}
			</if>
			<if test="producto!=null">
				and cdpr_producto = #{producto}
			</if>
			<if test="fechaMin!=null">
				and ddpr_fecha >= #{fechaMin}
			</if>
			<if test="fechaMax!=null">
				and ddpr_fecha <![CDATA[ < ]]>  #{fechaMax}
			</if>
			<if test="responsable!=null">
				and cdpr_responsable = #{responsable}
			</if>
			<if test="bodega!=null">
				and cdpr_bodega = #{bodega}
			</if>
	</sql>

	<sql id="paginationDeduccionProductoFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="whereDeduccionProductoPrimaryKeyFragment">
		where
			cdpr_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="DeduccionProductoDTO" resultType="DeduccionProductoDTO">
		<include refid="selectDeduccionProductoFragment" />
		<include refid="whereDeduccionProductoFragment" />
	</select>
	
	<select id="listar" parameterType="DeduccionProductoDTO" resultType="DeduccionProductoDTO">
		<include refid="selectDeduccionProductoFragment" />
		<include refid="whereDeduccionProductoFragment" />
		<include refid="paginationDeduccionProductoFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="DeduccionProductoDTO" resultType="int">
		select count(*)
		from deduccionproducto_dprp
		<include refid="whereDeduccionProductoFragment" />
	</select>


	<select id="insertar" parameterType="DeduccionProductoDTO" resultType="DeduccionProductoDTO">
		insert into deduccionproducto_dprp(
			cdpr_llave
		<if test="documento!=null">
			,cdpr_documento
		</if>
		<if test="producto!=null">
			,cdpr_producto
		</if>
		<if test="fecha!=null">
			,ddpr_fecha
		</if>
		<if test="cantidad!=null">
			,mdpr_cantidad
		</if>
		<if test="responsable!=null">
			,cdpr_responsable
		</if>
		<if test="bodega!=null">
			,cdpr_bodega
		</if>
		<if test="estado!=null">
			,cdpr_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="documento!=null">
			,#{documento}
		</if>
		<if test="producto!=null">
			,#{producto}
		</if>
		<if test="fecha!=null">
			,#{fecha}
		</if>
		<if test="cantidad!=null">
			,#{cantidad}
		</if>
		<if test="responsable!=null">
			,#{responsable}
		</if>
		<if test="bodega!=null">
			,#{bodega}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="DeduccionProductoDTO" resultType="DeduccionProductoDTO">
		update deduccionproducto_dprp
			set
				cdpr_documento = #{documento},
				cdpr_producto = #{producto},
				ddpr_fecha = #{fecha},
				mdpr_cantidad = #{cantidad},
				cdpr_responsable = #{responsable},
				cdpr_bodega = #{bodega},
				cdpr_estado =#{estado}
		<include refid="whereDeduccionProductoPrimaryKeyFragment" />
	</select>


<!--// BEGIN region script-->
<!--// END region script-->

</mapper>