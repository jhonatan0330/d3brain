<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.softure.logisticpymes.persistence.PedidoVentaDineroMapper">

	<sql id="selectPedidoVentaDineroFragment">
		select
			cpvd_llave as  llaveTabla
			,cpvd_documento as  documento
			,dpvd_fecha as  fecha
			,mpvd_valortotal as  valorTotal
			,mpvd_saldo as  saldo
			,cpvd_estado as estado
		from pedidoventadinero_pvdp a
	</sql>

	<sql id="wherePedidoVentaDineroFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and cpvd_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and cpvd_estado = #{estado}
			</if>
			<if test="documento!=null">
				and cpvd_documento = #{documento}
			</if>
			<if test="fechaMin!=null">
				and dpvd_fecha >= #{fechaMin}
			</if>
			<if test="fechaMax!=null">
				and dpvd_fecha <![CDATA[ < ]]>  #{fechaMax}
			</if>
	</sql>

	<sql id="paginationPedidoVentaDineroFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="wherePedidoVentaDineroPrimaryKeyFragment">
		where
			cpvd_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="PedidoVentaDineroDTO" resultType="PedidoVentaDineroDTO">
		<include refid="selectPedidoVentaDineroFragment" />
		<include refid="wherePedidoVentaDineroFragment" />
	</select>
	
	<select id="listar" parameterType="PedidoVentaDineroDTO" resultType="PedidoVentaDineroDTO">
		<include refid="selectPedidoVentaDineroFragment" />
		<include refid="wherePedidoVentaDineroFragment" />
		<include refid="paginationPedidoVentaDineroFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="PedidoVentaDineroDTO" resultType="int">
		select count(*)
		from pedidoventadinero_pvdp
		<include refid="wherePedidoVentaDineroFragment" />
	</select>


	<select id="insertar" parameterType="PedidoVentaDineroDTO" resultType="PedidoVentaDineroDTO">
		insert into pedidoventadinero_pvdp(
			cpvd_llave
		<if test="documento!=null">
			,cpvd_documento
		</if>
		<if test="fecha!=null">
			,dpvd_fecha
		</if>
		<if test="valorTotal!=null">
			,mpvd_valortotal
		</if>
		<if test="saldo!=null">
			,mpvd_saldo
		</if>
		<if test="estado!=null">
			,cpvd_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="documento!=null">
			,#{documento}
		</if>
		<if test="fecha!=null">
			,#{fecha}
		</if>
		<if test="valorTotal!=null">
			,#{valorTotal}
		</if>
		<if test="saldo!=null">
			,#{saldo}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="PedidoVentaDineroDTO" resultType="PedidoVentaDineroDTO">
		update pedidoventadinero_pvdp
			set
				cpvd_documento = #{documento},
				dpvd_fecha = #{fecha},
				mpvd_valortotal = #{valorTotal},
				mpvd_saldo = #{saldo},
				cpvd_estado =#{estado}
		<include refid="wherePedidoVentaDineroPrimaryKeyFragment" />
	</select>


<!--// BEGIN region script-->
	<select id="listar2DocumentoVisible" resultType="PedidoVentaDineroDTO">
		<include refid="selectPedidoVentaDineroFragment" />
		where cpvd_estado ='A' and cpvd_documento in (<foreach item="item" collection="documentos" separator="," >#{item.llaveTabla}</foreach>)
	</select>
<!--// END region script-->

</mapper>