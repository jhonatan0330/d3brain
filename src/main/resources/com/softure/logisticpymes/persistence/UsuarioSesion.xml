<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.softure.logisticpymes.persistence.UsuarioSesionMapper">

	<sql id="selectUsuarioSesionFragment">
		select
			cuss_llave as  llaveTabla
			,cuss_usuario as  usuario
			,duss_fecha as  fecha
			,duss_fechacierre as  fechaCierre
			,cuss_estado as estado
		from usuariosesion_ussp a
	</sql>

	<sql id="whereUsuarioSesionFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and cuss_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and cuss_estado = #{estado}
			</if>
			<if test="usuario!=null">
				and cuss_usuario = #{usuario}
			</if>
			<if test="fechaMin!=null">
				and duss_fecha >= #{fechaMin}
			</if>
			<if test="fechaMax!=null">
				and duss_fecha <![CDATA[ < ]]>  #{fechaMax}
			</if>
			<if test="fechaCierreMin!=null">
				and duss_fechacierre >= #{fechaCierreMin}
			</if>
			<if test="fechaCierreMax!=null">
				and duss_fechacierre <![CDATA[ < ]]>  #{fechaCierreMax}
			</if>
	</sql>

	<sql id="paginationUsuarioSesionFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="whereUsuarioSesionPrimaryKeyFragment">
		where
			cuss_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="UsuarioSesionDTO" resultType="UsuarioSesionDTO">
		<include refid="selectUsuarioSesionFragment" />
		<include refid="whereUsuarioSesionFragment" />
	</select>
	
	<select id="listar" parameterType="UsuarioSesionDTO" resultType="UsuarioSesionDTO">
		<include refid="selectUsuarioSesionFragment" />
		<include refid="whereUsuarioSesionFragment" />
		<include refid="paginationUsuarioSesionFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="UsuarioSesionDTO" resultType="int">
		select count(*)
		from usuariosesion_ussp
		<include refid="whereUsuarioSesionFragment" />
	</select>


	<select id="insertar" parameterType="UsuarioSesionDTO" resultType="UsuarioSesionDTO">
		insert into usuariosesion_ussp(
			cuss_llave
		<if test="usuario!=null">
			,cuss_usuario
		</if>
		<if test="fecha!=null">
			,duss_fecha
		</if>
		<if test="fechaCierre!=null">
			,duss_fechacierre
		</if>
		<if test="estado!=null">
			,cuss_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="usuario!=null">
			,#{usuario}
		</if>
		<if test="fecha!=null">
			,#{fecha}
		</if>
		<if test="fechaCierre!=null">
			,#{fechaCierre}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="UsuarioSesionDTO" resultType="UsuarioSesionDTO">
		update usuariosesion_ussp
			set
				cuss_usuario = #{usuario},
				duss_fecha = #{fecha},
				duss_fechacierre = #{fechaCierre},
				cuss_estado =#{estado}
		<include refid="whereUsuarioSesionPrimaryKeyFragment" />
	</select>


<!--// BEGIN region script-->
	<select id="tiempoSesion" parameterType="java.lang.String" resultType="int">
		select coalesce(max(nrac_minutossesion),0) from 
		usuariorol_erlp, rolacceso_racp
		where crac_llave = cerl_rolacceso 
		and cerl_estado ='A' 
		and crac_estado = 'A'
		and cerl_usuario = #{usuario}
	</select>
<!--// END region script-->

</mapper>