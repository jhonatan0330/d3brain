<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.softure.logisticpymes.persistence.TurnoMapper">

	<sql id="selectTurnoFragment">
		select
			ctur_llave as  llaveTabla
			,dtur_fechaapertura as  fechaApertura
			,dtur_fechaentrega as  fechaEntrega
			,mtur_montoinicial as  montoInicial
			,mtur_montofinal as  montoFinal
			,ctur_documento as  documento
			,ctur_usuario as  usuario
			,(select cusr_nombre from usuario_usrp where cusr_llave = ctur_usuario) as  usuarioNombre
			,ctur_cuenta as  cuenta
			,(select ccue_nombre from cuenta_cuep where ccue_llave = ctur_cuenta) as  cuentaNombre
			,ctur_estado as estado
		from turno_turp a
	</sql>

	<sql id="whereTurnoFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and ctur_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and ctur_estado = #{estado}
			</if>
			<if test="fechaAperturaMin!=null">
				and dtur_fechaapertura >= #{fechaAperturaMin}
			</if>
			<if test="fechaAperturaMax!=null">
				and dtur_fechaapertura <![CDATA[ < ]]>  #{fechaAperturaMax}
			</if>
			<if test="fechaEntregaMin!=null">
				and dtur_fechaentrega >= #{fechaEntregaMin}
			</if>
			<if test="fechaEntregaMax!=null">
				and dtur_fechaentrega <![CDATA[ < ]]>  #{fechaEntregaMax}
			</if>
			<if test="documento!=null">
				and ctur_documento = #{documento}
			</if>
			<if test="usuario!=null">
				and ctur_usuario = #{usuario}
			</if>
			<if test="cuenta!=null">
				and ctur_cuenta = #{cuenta}
			</if>
	</sql>

	<sql id="paginationTurnoFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="whereTurnoPrimaryKeyFragment">
		where
			ctur_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="TurnoDTO" resultType="TurnoDTO">
		<include refid="selectTurnoFragment" />
		<include refid="whereTurnoFragment" />
	</select>
	
	<select id="listar" parameterType="TurnoDTO" resultType="TurnoDTO">
		<include refid="selectTurnoFragment" />
		<include refid="whereTurnoFragment" />
		<include refid="paginationTurnoFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="TurnoDTO" resultType="int">
		select count(*)
		from turno_turp
		<include refid="whereTurnoFragment" />
	</select>


	<select id="insertar" parameterType="TurnoDTO" resultType="TurnoDTO">
		insert into turno_turp(
			ctur_llave
		<if test="fechaApertura!=null">
			,dtur_fechaapertura
		</if>
		<if test="fechaEntrega!=null">
			,dtur_fechaentrega
		</if>
		<if test="montoInicial!=null">
			,mtur_montoinicial
		</if>
		<if test="montoFinal!=null">
			,mtur_montofinal
		</if>
		<if test="documento!=null">
			,ctur_documento
		</if>
		<if test="usuario!=null">
			,ctur_usuario
		</if>
		<if test="cuenta!=null">
			,ctur_cuenta
		</if>
		<if test="estado!=null">
			,ctur_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="fechaApertura!=null">
			,#{fechaApertura}
		</if>
		<if test="fechaEntrega!=null">
			,#{fechaEntrega}
		</if>
		<if test="montoInicial!=null">
			,#{montoInicial}
		</if>
		<if test="montoFinal!=null">
			,#{montoFinal}
		</if>
		<if test="documento!=null">
			,#{documento}
		</if>
		<if test="usuario!=null">
			,#{usuario}
		</if>
		<if test="cuenta!=null">
			,#{cuenta}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="TurnoDTO" resultType="TurnoDTO">
		update turno_turp
			set
				dtur_fechaapertura = #{fechaApertura},
				dtur_fechaentrega = #{fechaEntrega},
				mtur_montoinicial = #{montoInicial},
				mtur_montofinal = #{montoFinal},
				ctur_documento = #{documento},
				ctur_usuario = #{usuario},
				ctur_cuenta = #{cuenta},
				ctur_estado =#{estado}
		<include refid="whereTurnoPrimaryKeyFragment" />
	</select>


<!--// BEGIN region script-->
<!--// END region script-->

</mapper>