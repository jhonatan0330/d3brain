<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.softure.logisticpymes.persistence.BodegaMapper">

	<sql id="selectBodegaFragment">
		select
			cbod_llave as  llaveTabla
			,descripcion(cbod_documento) as  nombre
			,(select cpdv_nombre from pedidoventa_pdvp where cpdv_llave =cbod_documento) as  codigo
			,cbod_documento as  documento
			,cbod_estado as estado
		from bodega_bodp a
	</sql>

	<sql id="whereBodegaFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and cbod_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and cbod_estado = #{estado}
			</if>
			<if test="documento!=null">
				and cbod_documento = #{documento}
			</if>
	</sql>

	<sql id="paginationBodegaFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="whereBodegaPrimaryKeyFragment">
		where
			cbod_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="BodegaDTO" resultType="BodegaDTO">
		<include refid="selectBodegaFragment" />
		<include refid="whereBodegaFragment" />
	</select>
	
	<select id="listar" parameterType="BodegaDTO" resultType="BodegaDTO">
		<include refid="selectBodegaFragment" />
		<include refid="whereBodegaFragment" />
		<include refid="paginationBodegaFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="BodegaDTO" resultType="int">
		select count(*)
		from bodega_bodp
		<include refid="whereBodegaFragment" />
	</select>


	<select id="insertar" parameterType="BodegaDTO" resultType="BodegaDTO">
		insert into bodega_bodp(
			cbod_llave
		<if test="documento!=null">
			,cbod_documento
		</if>
		<if test="estado!=null">
			,cbod_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="documento!=null">
			,#{documento}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="BodegaDTO" resultType="BodegaDTO">
		update bodega_bodp
			set
				cbod_documento = #{documento},
				cbod_estado =#{estado}
		<include refid="whereBodegaPrimaryKeyFragment" />
	</select>
	
	<sql id="selectSimpleBodegaFragment">
		select
			cbod_llave as  llaveTabla
			,cbod_documento as  documento
			,cbod_estado as estado
		from bodega_bodp a
	</sql>
	
	<select id="consultarSimple" resultType="BodegaDTO">
		<include refid="selectSimpleBodegaFragment" />
		<include refid="whereBodegaFragment" />
	</select>
	
	<select id="listarSimple" resultType="BodegaDTO">
		<include refid="selectSimpleBodegaFragment" />
		<include refid="whereBodegaFragment" />
		<include refid="paginationBodegaFragment" />
	</select>
	


<!--// BEGIN region script-->
<!--// END region script-->

</mapper>