<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.softure.logisticpymes.persistence.WebServiceEjecucionMapper">

	<sql id="selectWebServiceEjecucionFragment">
		select
			cwse_llave as  llaveTabla
			,cwse_servicio as  servicio
			,dwse_fecha as  fecha
			,cwse_documento as  documento
			,cwse_entrada as  entrada
			,cwse_salida as  salida
			,cwse_error as  error
			,cwse_estado as estado
		from webserviceejecucion_wsep a
	</sql>

	<sql id="whereWebServiceEjecucionFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and cwse_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and cwse_estado = #{estado}
			</if>
			<if test="servicio!=null">
				and cwse_servicio = #{servicio}
			</if>
			<if test="fechaMin!=null">
				and dwse_fecha >= #{fechaMin}
			</if>
			<if test="fechaMax!=null">
				and dwse_fecha <![CDATA[ < ]]>  #{fechaMax}
			</if>
			<if test="documento!=null">
				and cwse_documento = #{documento}
			</if>
	</sql>

	<sql id="paginationWebServiceEjecucionFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="whereWebServiceEjecucionPrimaryKeyFragment">
		where
			cwse_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="WebServiceEjecucionDTO" resultType="WebServiceEjecucionDTO">
		<include refid="selectWebServiceEjecucionFragment" />
		<include refid="whereWebServiceEjecucionFragment" />
	</select>
	
	<select id="listar" parameterType="WebServiceEjecucionDTO" resultType="WebServiceEjecucionDTO">
		<include refid="selectWebServiceEjecucionFragment" />
		<include refid="whereWebServiceEjecucionFragment" />
		order by dwse_fecha desc
		<include refid="paginationWebServiceEjecucionFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="WebServiceEjecucionDTO" resultType="int">
		select count(*)
		from webserviceejecucion_wsep
		<include refid="whereWebServiceEjecucionFragment" />
	</select>


	<select id="insertar" parameterType="WebServiceEjecucionDTO" resultType="WebServiceEjecucionDTO">
		insert into webserviceejecucion_wsep(
			cwse_llave
		<if test="servicio!=null">
			,cwse_servicio
		</if>
		<if test="fecha!=null">
			,dwse_fecha
		</if>
		<if test="documento!=null">
			,cwse_documento
		</if>
		<if test="entrada!=null">
			,cwse_entrada
		</if>
		<if test="salida!=null">
			,cwse_salida
		</if>
		<if test="error!=null">
			,cwse_error
		</if>
		<if test="estado!=null">
			,cwse_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="servicio!=null">
			,#{servicio}
		</if>
		<if test="fecha!=null">
			,#{fecha}
		</if>
		<if test="documento!=null">
			,#{documento}
		</if>
		<if test="entrada!=null">
			,#{entrada}
		</if>
		<if test="salida!=null">
			,#{salida}
		</if>
		<if test="error!=null">
			,#{error}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="WebServiceEjecucionDTO" resultType="WebServiceEjecucionDTO">
		update webserviceejecucion_wsep
			set
				cwse_servicio = #{servicio},
				dwse_fecha = #{fecha},
				cwse_documento = #{documento},
				cwse_entrada = #{entrada},
				cwse_salida = #{salida},
				cwse_error = #{error},
				cwse_estado =#{estado}
		<include refid="whereWebServiceEjecucionPrimaryKeyFragment" />
	</select>
	
	<sql id="selectSimpleWebServiceEjecucionFragment">
		select
			cwse_llave as  llaveTabla
			,cwse_servicio as  servicio
			,dwse_fecha as  fecha
			,cwse_documento as  documento
			,cwse_entrada as  entrada
			,cwse_salida as  salida
			,cwse_error as  error
			,cwse_estado as estado
		from webserviceejecucion_wsep a
	</sql>
	
	<select id="consultarSimple" resultType="WebServiceEjecucionDTO">
		<include refid="selectSimpleWebServiceEjecucionFragment" />
		<include refid="whereWebServiceEjecucionFragment" />
	</select>
	
	<select id="listarSimple" resultType="WebServiceEjecucionDTO">
		<include refid="selectSimpleWebServiceEjecucionFragment" />
		<include refid="whereWebServiceEjecucionFragment" />
		order by dwse_fecha desc
		<include refid="paginationWebServiceEjecucionFragment" />
	</select>
	


<!--// BEGIN region script-->
<!--// END region script-->

</mapper>