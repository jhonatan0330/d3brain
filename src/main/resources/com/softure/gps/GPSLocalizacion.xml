<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.softure.gps.infrastructure.GPSLocalizacionMapper">

	<sql id="selectGPSLocalizacionFragment">
		select
			cgpl_llave as  llaveTabla
			,cgpl_dispositivo as  dispositivo
			,dgpl_fecha as  fecha
			,mgpl_longitud as  longitud
			,mgpl_latitud as  latitud
			,cgpl_estado as estado
		from gpslocalizacion_gplp a
	</sql>

	<sql id="whereGPSLocalizacionFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and cgpl_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and cgpl_estado = #{estado}
			</if>
			<if test="dispositivo!=null">
				and cgpl_dispositivo = #{dispositivo}
			</if>
			<if test="fechaMin!=null">
				and dgpl_fecha >= #{fechaMin}
			</if>
			<if test="fechaMax!=null">
				and dgpl_fecha <![CDATA[ < ]]>  #{fechaMax}
			</if>
	</sql>

	<sql id="paginationGPSLocalizacionFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="whereGPSLocalizacionPrimaryKeyFragment">
		where
			cgpl_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="GPSLocalizacionDTO" resultType="GPSLocalizacionDTO">
		<include refid="selectGPSLocalizacionFragment" />
		<include refid="whereGPSLocalizacionFragment" />
	</select>
	
	<select id="listar" parameterType="GPSLocalizacionDTO" resultType="GPSLocalizacionDTO">
		<include refid="selectGPSLocalizacionFragment" />
		<include refid="whereGPSLocalizacionFragment" />
		<include refid="paginationGPSLocalizacionFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="GPSLocalizacionDTO" resultType="int">
		select count(*)
		from gpslocalizacion_gplp
		<include refid="whereGPSLocalizacionFragment" />
	</select>


	<select id="insertar" parameterType="GPSLocalizacionDTO" resultType="GPSLocalizacionDTO">
		insert into gpslocalizacion_gplp(
			cgpl_llave
		<if test="dispositivo!=null">
			,cgpl_dispositivo
		</if>
		<if test="fecha!=null">
			,dgpl_fecha
		</if>
		<if test="longitud!=null">
			,mgpl_longitud
		</if>
		<if test="latitud!=null">
			,mgpl_latitud
		</if>
		<if test="estado!=null">
			,cgpl_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="dispositivo!=null">
			,#{dispositivo}
		</if>
		<if test="fecha!=null">
			,#{fecha}
		</if>
		<if test="longitud!=null">
			,#{longitud}
		</if>
		<if test="latitud!=null">
			,#{latitud}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="GPSLocalizacionDTO" resultType="GPSLocalizacionDTO">
		update gpslocalizacion_gplp
			set
				cgpl_dispositivo = #{dispositivo},
				dgpl_fecha = #{fecha},
				mgpl_longitud = #{longitud},
				mgpl_latitud = #{latitud},
				cgpl_estado =#{estado}
		<include refid="whereGPSLocalizacionPrimaryKeyFragment" />
	</select>
	
	<sql id="selectSimpleGPSLocalizacionFragment">
		select
			cgpl_llave as  llaveTabla
			,cgpl_dispositivo as  dispositivo
			,dgpl_fecha as  fecha
			,mgpl_longitud as  longitud
			,mgpl_latitud as  latitud
			,cgpl_estado as estado
		from gpslocalizacion_gplp a
	</sql>
	
	<select id="consultarSimple" resultType="GPSLocalizacionDTO">
		<include refid="selectSimpleGPSLocalizacionFragment" />
		<include refid="whereGPSLocalizacionFragment" />
	</select>
	
	<select id="listarSimple" resultType="GPSLocalizacionDTO">
		<include refid="selectSimpleGPSLocalizacionFragment" />
		<include refid="whereGPSLocalizacionFragment" />
		<include refid="paginationGPSLocalizacionFragment" />
	</select>
	


<!--// BEGIN region script-->
<!--// END region script-->

</mapper>