<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.softure.authorization.infrastructure.ModuloMapper">

	<sql id="selectModuloFragment">
		select
			cmod_llave as  llaveTabla
			,cmod_nombre as  nombre
			,cmod_url as  moduloUrl
			,cmod_descripcion as  descripcion
			,cmod_imagen as  imagen
			,bmod_movil as  movil
			,cmod_estado as estado
		from modulo_modp a
	</sql>

	<sql id="whereModuloFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and cmod_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and cmod_estado = #{estado}
			</if>
			<if test="nombre!=null">
				and cmod_nombre = #{nombre}
			</if>
			<if test="movilFilter!=null">
				and bmod_movil = #{movilFilter}
			</if>
			<if test="filtroParametro!=null">
				and (upper(cmod_nombre) like upper('%' || #{filtroParametro} || '%'))
			</if>
	</sql>

	<sql id="paginationModuloFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="whereModuloPrimaryKeyFragment">
		where
			cmod_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="ModuloDTO" resultType="ModuloDTO">
		<include refid="selectModuloFragment" />
		<include refid="whereModuloFragment" />
	</select>
	
	<select id="listar" parameterType="ModuloDTO" resultType="ModuloDTO">
		<include refid="selectModuloFragment" />
		<include refid="whereModuloFragment" />
		order by cmod_nombre 
		<include refid="paginationModuloFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="ModuloDTO" resultType="int">
		select count(*)
		from modulo_modp
		<include refid="whereModuloFragment" />
	</select>


	<select id="insertar" parameterType="ModuloDTO" resultType="ModuloDTO">
		insert into modulo_modp(
			cmod_llave
		<if test="nombre!=null">
			,cmod_nombre
		</if>
		<if test="moduloUrl!=null">
			,cmod_url
		</if>
		<if test="descripcion!=null">
			,cmod_descripcion
		</if>
		<if test="imagen!=null">
			,cmod_imagen
		</if>
		<if test="movil!=null">
			,bmod_movil
		</if>
		<if test="estado!=null">
			,cmod_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="nombre!=null">
			,#{nombre}
		</if>
		<if test="moduloUrl!=null">
			,#{moduloUrl}
		</if>
		<if test="descripcion!=null">
			,#{descripcion}
		</if>
		<if test="imagen!=null">
			,#{imagen}
		</if>
		<if test="movil!=null">
			,#{movil}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="ModuloDTO" resultType="ModuloDTO">
		update modulo_modp
			set
				cmod_nombre = #{nombre},
				cmod_url = #{moduloUrl},
				cmod_descripcion = #{descripcion},
				cmod_imagen = #{imagen},
				bmod_movil = #{movil},
				cmod_estado =#{estado}
		<include refid="whereModuloPrimaryKeyFragment" />
	</select>
	
	<sql id="selectSimpleModuloFragment">
		select
			cmod_llave as  llaveTabla
			,cmod_nombre as  nombre
			,cmod_url as  moduloUrl
			,cmod_descripcion as  descripcion
			,bmod_movil as  movil
			,cmod_estado as estado
		from modulo_modp a
	</sql>
	
	<select id="consultarSimple" resultType="ModuloDTO">
		<include refid="selectSimpleModuloFragment" />
		<include refid="whereModuloFragment" />
	</select>
	
	<select id="listarSimple" resultType="ModuloDTO">
		<include refid="selectSimpleModuloFragment" />
		<include refid="whereModuloFragment" />
		order by cmod_nombre 
		<include refid="paginationModuloFragment" />
	</select>

	<select id="modulosUsuario" parameterType="ModuloDTO" resultType="ModuloDTO">
		<include refid="selectModuloFragment" />
		where cmod_estado = 'A' and cmod_llave in (
			select cper_modulo from permiso_perp where cper_estado = 'A' and cper_rolacceso in (
				select cerl_rolacceso from usuariorol_erlp  where cerl_estado = 'A' and cerl_usuario = (
					select cuss_usuario from usuariosesion_ussp where cuss_llave = #{securityToken})))
		order by cmod_nombre
	</select>
<!--// BEGIN region script-->
<!--// END region script-->

</mapper>