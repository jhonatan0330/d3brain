<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.softure.document_execution.infrastructure.PedidoVentaUbicacionMapper">

	<sql id="selectPedidoVentaUbicacionFragment">
		select
			cpvu_llave as  llaveTabla
			,cpvu_documento as  documento
			,dpvu_fecha as  fecha
			,cpvu_ubicacion as  ubicacion
			,cpvu_modificador as  modificador
			,cpvu_estado as estado
		from pedidoventaubicacion_pvup a
	</sql>

	<sql id="wherePedidoVentaUbicacionFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and cpvu_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and cpvu_estado = #{estado}
			</if>
			<if test="documento!=null">
				and cpvu_documento = #{documento}
			</if>
			<if test="fechaMin!=null">
				and dpvu_fecha >= #{fechaMin}
			</if>
			<if test="fechaMax!=null">
				and dpvu_fecha <![CDATA[ < ]]>  #{fechaMax}
			</if>
	</sql>

	<sql id="paginationPedidoVentaUbicacionFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="wherePedidoVentaUbicacionPrimaryKeyFragment">
		where
			cpvu_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="PedidoVentaUbicacionDTO" resultType="PedidoVentaUbicacionDTO">
		<include refid="selectPedidoVentaUbicacionFragment" />
		<include refid="wherePedidoVentaUbicacionFragment" />
	</select>
	
	<select id="listar" parameterType="PedidoVentaUbicacionDTO" resultType="PedidoVentaUbicacionDTO">
		<include refid="selectPedidoVentaUbicacionFragment" />
		<include refid="wherePedidoVentaUbicacionFragment" />
		<include refid="paginationPedidoVentaUbicacionFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="PedidoVentaUbicacionDTO" resultType="int">
		select count(*)
		from pedidoventaubicacion_pvup
		<include refid="wherePedidoVentaUbicacionFragment" />
	</select>


	<select id="insertar" parameterType="PedidoVentaUbicacionDTO" resultType="PedidoVentaUbicacionDTO">
		insert into pedidoventaubicacion_pvup(
			cpvu_llave
		<if test="documento!=null">
			,cpvu_documento
		</if>
		<if test="fecha!=null">
			,dpvu_fecha
		</if>
		<if test="ubicacion!=null">
			,cpvu_ubicacion
		</if>
		<if test="modificador!=null">
			,cpvu_modificador
		</if>
		<if test="estado!=null">
			,cpvu_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="documento!=null">
			,#{documento}
		</if>
		<if test="fecha!=null">
			,#{fecha}
		</if>
		<if test="ubicacion!=null">
			,#{ubicacion}
		</if>
		<if test="modificador!=null">
			,#{modificador}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="PedidoVentaUbicacionDTO" resultType="PedidoVentaUbicacionDTO">
		update pedidoventaubicacion_pvup
			set
				cpvu_documento = #{documento},
				dpvu_fecha = #{fecha},
				cpvu_ubicacion = #{ubicacion},
				cpvu_modificador = #{modificador},
				cpvu_estado =#{estado}
		<include refid="wherePedidoVentaUbicacionPrimaryKeyFragment" />
	</select>


	<select id="consultaPorDocumento" resultType="PedidoVentaUbicacionDTO">
		select
			cpvu_llave as  llaveTabla
			,cpvu_documento as  documento
			,dpvu_fecha as  fecha
			,cpvu_ubicacion as  ubicacion
			,cpvu_modificador as  modificador
			,cpvu_estado as estado
		from <if test="historico!=null">historic.z_pvu_pedidoventaubicacion</if><if test="historico==null">pedidoventaubicacion_pvup</if>
		where cpvu_documento = #{idCampo} and #{ramdom} != '0' and cpvu_estado = 'A'
	</select>
	
	<select id="listar2DocumentoVisible" resultType="PedidoVentaUbicacionDTO">
		<if test="documentos!=null">
		select
			cpvu_llave as  llaveTabla
			,cpvu_documento as  documento
			,dpvu_fecha as  fecha
			,cpvu_ubicacion as  ubicacion
			,cpvu_modificador as  modificador
			,cpvu_estado as estado
		from pedidoventaubicacion_pvup
		where cpvu_estado ='A' and cpvu_documento in (<foreach item="item" collection="documentos" separator="," >#{item.llaveTabla}</foreach>)
		</if>
		<if test="historicos!=null">
		<if test="documentos!=null">union</if>
		select
			cpvu_llave as  llaveTabla
			,cpvu_documento as  documento
			,dpvu_fecha as  fecha
			,cpvu_ubicacion as  ubicacion
			,cpvu_modificador as  modificador
			,cpvu_estado as estado
		from historic.z_pvu_pedidoventaubicacion
			where cpvu_estado ='A' and cpvu_documento in (<foreach item="item" collection="historicos" separator="," >#{item.llaveTabla}</foreach>)
		</if>
	</select>
	
	<select id="insertarHistorico" parameterType="PedidoVentaUbicacionDTO" resultType="PedidoVentaUbicacionDTO">
		insert into historic.z_pvu_pedidoventaubicacion(
			cpvu_llave
		<if test="documento!=null">
			,cpvu_documento
		</if>
		<if test="fecha!=null">
			,dpvu_fecha
		</if>
		<if test="ubicacion!=null">
			,cpvu_ubicacion
		</if>
		<if test="modificador!=null">
			,cpvu_modificador
		</if>
		<if test="estado!=null">
			,cpvu_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="documento!=null">
			,#{documento}
		</if>
		<if test="fecha!=null">
			,#{fecha}
		</if>
		<if test="ubicacion!=null">
			,#{ubicacion}
		</if>
		<if test="modificador!=null">
			,#{modificador}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>
	
	<select id="inactivarHistorico" resultType="PedidoVentaCaracteristicaDTO">
		update <if test="historico!=null">historic.z_pvu_pedidoventaubicacion</if><if test="historico==null">pedidoventaubicacion_pvup</if>
			set	cpvu_estado = 'I'
		where cpvu_llave = #{idCampo}
	</select>
<!--// END region script-->

</mapper>