<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.softure.massiveload.infrastructure.ICargaMasivaItemMapper">

	<sql id="selectCargaMasivaItemFragment">
		select
			ccmi_llave as  llaveTabla
			,ccmi_carga as  carga
			,ccmi_modelo as  modelo
			,ccmi_progreso as  progreso
			,ccmi_estado as estado
		from cargamasivaitem_cmip a
	</sql>

	<sql id="whereCargaMasivaItemFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and ccmi_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and ccmi_estado = #{estado}
			</if>
			<if test="carga!=null">
				and ccmi_carga = #{carga}
			</if>
			<if test="progreso!=null">
				and ccmi_progreso = #{progreso}
			</if>
	</sql>

	<sql id="paginationCargaMasivaItemFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="whereCargaMasivaItemPrimaryKeyFragment">
		where
			ccmi_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="CargaMasivaItemDTO" resultType="CargaMasivaItemDTO">
		<include refid="selectCargaMasivaItemFragment" />
		<include refid="whereCargaMasivaItemFragment" />
	</select>
	
	<select id="listar" parameterType="CargaMasivaItemDTO" resultType="CargaMasivaItemDTO">
		<include refid="selectCargaMasivaItemFragment" />
		<include refid="whereCargaMasivaItemFragment" />
		<include refid="paginationCargaMasivaItemFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="CargaMasivaItemDTO" resultType="int">
		select count(*)
		from cargamasivaitem_cmip
		<include refid="whereCargaMasivaItemFragment" />
	</select>


	<select id="insertar" parameterType="CargaMasivaItemDTO" resultType="CargaMasivaItemDTO">
		insert into cargamasivaitem_cmip(
			ccmi_llave
		<if test="carga!=null">
			,ccmi_carga
		</if>
		<if test="modelo!=null">
			,ccmi_modelo
		</if>
		<if test="progreso!=null">
			,ccmi_progreso
		</if>
		<if test="estado!=null">
			,ccmi_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="carga!=null">
			,#{carga}
		</if>
		<if test="modelo!=null">
			,#{modelo}
		</if>
		<if test="progreso!=null">
			,#{progreso}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="CargaMasivaItemDTO" resultType="CargaMasivaItemDTO">
		update cargamasivaitem_cmip
			set
				ccmi_carga = #{carga},
				ccmi_modelo = #{modelo},
				ccmi_progreso = #{progreso},
				ccmi_estado =#{estado}
		<include refid="whereCargaMasivaItemPrimaryKeyFragment" />
	</select>
	
	<sql id="selectSimpleCargaMasivaItemFragment">
		select
			ccmi_llave as  llaveTabla
			,ccmi_carga as  carga
			,ccmi_modelo as  modelo
			,ccmi_progreso as  progreso
			,ccmi_estado as estado
		from cargamasivaitem_cmip a
	</sql>
	
	<select id="consultarSimple" resultType="CargaMasivaItemDTO">
		<include refid="selectSimpleCargaMasivaItemFragment" />
		<include refid="whereCargaMasivaItemFragment" />
	</select>
	
	<select id="listarSimple" resultType="CargaMasivaItemDTO">
		<include refid="selectSimpleCargaMasivaItemFragment" />
		<include refid="whereCargaMasivaItemFragment" />
		<include refid="paginationCargaMasivaItemFragment" />
	</select>
	


<!--// BEGIN region script-->
<!--// END region script-->

</mapper>