<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.softure.inventory.infrastructure.DetalleCaracteristicaProductoMapper">

	<sql id="selectDetalleCaracteristicaProductoFragment">
		select
			cdcp_llave as  llaveTabla
			,cdcp_entidad as  entidad
			,cdcp_campo as  campo
			,ddcp_valorfecha as  valorFecha
			,cdcp_valortext as  valorText
			,mdcp_valornumero as  valorNumero
			,cdcp_valoropcion as  valorOpcion
			,cdcp_transaccionregistro as  transaccionRegistro
			,cdcp_transaccioninactivo as  transaccionInactivo
			,cdcp_estado as estado
		from detallecaracteristicaproducto_dcpp a
	</sql>

	<sql id="whereDetalleCaracteristicaProductoFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and cdcp_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and cdcp_estado = #{estado}
			</if>
			<if test="entidad!=null">
				and cdcp_entidad = #{entidad}
			</if>
			<if test="campo!=null">
				and cdcp_campo = #{campo}
			</if>
			<if test="valorFechaMin!=null">
				and ddcp_valorfecha >= #{valorFechaMin}
			</if>
			<if test="valorFechaMax!=null">
				and ddcp_valorfecha <![CDATA[ < ]]>  #{valorFechaMax}
			</if>
			<if test="valorOpcion!=null">
				and cdcp_valoropcion = #{valorOpcion}
			</if>
			<if test="transaccionRegistro!=null">
				and cdcp_transaccionregistro = #{transaccionRegistro}
			</if>
			<if test="transaccionInactivo!=null">
				and cdcp_transaccioninactivo = #{transaccionInactivo}
			</if>
	</sql>

	<sql id="paginationDetalleCaracteristicaProductoFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="whereDetalleCaracteristicaProductoPrimaryKeyFragment">
		where
			cdcp_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="DetalleCaracteristicaProductoDTO" resultType="DetalleCaracteristicaProductoDTO">
		<include refid="selectDetalleCaracteristicaProductoFragment" />
		<include refid="whereDetalleCaracteristicaProductoFragment" />
	</select>
	
	<select id="listar" parameterType="DetalleCaracteristicaProductoDTO" resultType="DetalleCaracteristicaProductoDTO">
		<include refid="selectDetalleCaracteristicaProductoFragment" />
		<include refid="whereDetalleCaracteristicaProductoFragment" />
		<include refid="paginationDetalleCaracteristicaProductoFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="DetalleCaracteristicaProductoDTO" resultType="int">
		select count(*)
		from detallecaracteristicaproducto_dcpp
		<include refid="whereDetalleCaracteristicaProductoFragment" />
	</select>


	<select id="insertar" parameterType="DetalleCaracteristicaProductoDTO" resultType="DetalleCaracteristicaProductoDTO">
		insert into detallecaracteristicaproducto_dcpp(
			cdcp_llave
		<if test="entidad!=null">
			,cdcp_entidad
		</if>
		<if test="campo!=null">
			,cdcp_campo
		</if>
		<if test="valorFecha!=null">
			,ddcp_valorfecha
		</if>
		<if test="valorText!=null">
			,cdcp_valortext
		</if>
		<if test="valorNumero!=null">
			,mdcp_valornumero
		</if>
		<if test="valorOpcion!=null">
			,cdcp_valoropcion
		</if>
		<if test="transaccionRegistro!=null">
			,cdcp_transaccionregistro
		</if>
		<if test="transaccionInactivo!=null">
			,cdcp_transaccioninactivo
		</if>
		<if test="estado!=null">
			,cdcp_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="entidad!=null">
			,#{entidad}
		</if>
		<if test="campo!=null">
			,#{campo}
		</if>
		<if test="valorFecha!=null">
			,#{valorFecha}
		</if>
		<if test="valorText!=null">
			,#{valorText}
		</if>
		<if test="valorNumero!=null">
			,#{valorNumero}
		</if>
		<if test="valorOpcion!=null">
			,#{valorOpcion}
		</if>
		<if test="transaccionRegistro!=null">
			,#{transaccionRegistro}
		</if>
		<if test="transaccionInactivo!=null">
			,#{transaccionInactivo}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="DetalleCaracteristicaProductoDTO" resultType="DetalleCaracteristicaProductoDTO">
		update detallecaracteristicaproducto_dcpp
			set
				cdcp_entidad = #{entidad},
				cdcp_campo = #{campo},
				ddcp_valorfecha = #{valorFecha},
				cdcp_valortext = #{valorText},
				mdcp_valornumero = #{valorNumero},
				cdcp_valoropcion = #{valorOpcion},
				cdcp_transaccionregistro = #{transaccionRegistro},
				cdcp_transaccioninactivo = #{transaccionInactivo},
				cdcp_estado =#{estado}
		<include refid="whereDetalleCaracteristicaProductoPrimaryKeyFragment" />
	</select>
	
	<sql id="selectSimpleDetalleCaracteristicaProductoFragment">
		select
			cdcp_llave as  llaveTabla
			,cdcp_entidad as  entidad
			,cdcp_campo as  campo
			,ddcp_valorfecha as  valorFecha
			,cdcp_valortext as  valorText
			,mdcp_valornumero as  valorNumero
			,cdcp_valoropcion as  valorOpcion
			,cdcp_transaccionregistro as  transaccionRegistro
			,cdcp_transaccioninactivo as  transaccionInactivo
			,cdcp_estado as estado
		from detallecaracteristicaproducto_dcpp a
	</sql>
	
	<select id="consultarSimple" resultType="DetalleCaracteristicaProductoDTO">
		<include refid="selectSimpleDetalleCaracteristicaProductoFragment" />
		<include refid="whereDetalleCaracteristicaProductoFragment" />
	</select>
	
	<select id="listarSimple" resultType="DetalleCaracteristicaProductoDTO">
		<include refid="selectSimpleDetalleCaracteristicaProductoFragment" />
		<include refid="whereDetalleCaracteristicaProductoFragment" />
		<include refid="paginationDetalleCaracteristicaProductoFragment" />
	</select>
	


<!--// BEGIN region script-->
