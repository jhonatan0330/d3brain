<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.softure.task.infrastructure.TaskMapper">

	<sql id="selectTaskFragment">
		select
			ctsk_llave as  id
			,ctsk_user as  user
			,ctsk_title as  title
			,ctsk_notes as  notes
			,ntsk_priority as  priority
			,ntsk_order as  order
			,dtsk_completed as  completed
			,dtsk_duedate as  dueDate
			,dtsk_createdat as  createdAt
			,ctsk_createduser as  createdUser
			,dtsk_updatedat as  updatedAt
			,ctsk_updateduser as  updatedUser
			,ctsk_state as state
		from task.task_tsk a
	</sql>

	<sql id="whereTaskFragment">
		where 1=1
			<if test="id!=null">
				and ctsk_llave = #{id}
			</if>
			<if test="state!=null">
				and ctsk_state = #{state}
			</if>
			<if test="user!=null">
				and ctsk_user = #{user}
			</if>
	</sql>

	<sql id="paginationTaskFragment">
			<if test="endRow!=null">
				LIMIT #{endRow}
			</if>
			<if test="startRow!=null">
				OFFSET #{startRow}
			</if>
	</sql>

	<sql id="whereTaskPrimaryKeyFragment">
		where
			ctsk_llave	=#{id}
	</sql>

	<select id="selectOne" parameterType="TaskDTO" resultType="TaskDTO">
		<include refid="selectTaskFragment" />
		<include refid="whereTaskFragment" />
	</select>
	
	<select id="selectMany" parameterType="TaskDTO" resultType="TaskDTO">
		<include refid="selectTaskFragment" />
		<include refid="whereTaskFragment" />
		order by ntsk_order
		<include refid="paginationTaskFragment" />
	</select>

	<select id="count" parameterType="TaskDTO" resultType="int">
		select count(*)
		from task.task_tsk a
		<include refid="whereTaskFragment" />
	</select>


	<select id="insert" parameterType="TaskDTO" resultType="TaskDTO">
		insert into task.task_tsk(
			ctsk_llave
		<if test="user!=null">
			,ctsk_user
		</if>
		<if test="title!=null">
			,ctsk_title
		</if>
		<if test="notes!=null">
			,ctsk_notes
		</if>
		<if test="priority!=null">
			,ntsk_priority
		</if>			
		<if test="order!=null">
			,ntsk_order
		</if>
		<if test="completed!=null">
			,dtsk_completed
		</if>
		<if test="dueDate!=null">
			,dtsk_dueDate
		</if>
		<if test="createdAt!=null">
			,dtsk_createdAt
		</if>
		<if test="createdUser!=null">
			,ctsk_createduser
		</if>
		<if test="state!=null">
			,ctsk_state
		</if>
		) values (
			#{id}
		<if test="user!=null">
			,#{user}
		</if>
		<if test="title!=null">
			,#{title}
		</if>
		<if test="notes!=null">
			,#{notes}
		</if>
		<if test="priority!=null">
			,#{priority}
		</if>			
		<if test="order!=null">
			,#{order}
		</if>
		<if test="completed!=null">
			,#{completed}
		</if>
		<if test="dueDate!=null">
			,#{dueDate}
		</if>
		<if test="createdAt!=null">
			,#{createdAt}
		</if>
		<if test="createdUser!=null">
			,#{createdUser}
		</if>
		<if test="state!=null">
			,#{state}
		</if>
		)
	</select>

	<select id="update" parameterType="TaskDTO" resultType="TaskDTO">
		update task.task_tsk
			set
				ctsk_user = #{user},
				ctsk_title = #{title},
				ctsk_notes = #{notes},
				ntsk_order = #{order},
				ntsk_priority = #{priority},
				dtsk_completed = #{completed},
				dtsk_duedate = #{dueDate},
				dtsk_updatedat = #{updatedAt},
				ctsk_updateduser = #{updatedUser},
				ctsk_state =#{state}
		<include refid="whereTaskPrimaryKeyFragment" />
	</select>
	
	<sql id="selectSimpleTaskFragment">
		select
			ctsk_llave as  id
			,ctsk_user as  user
			,ctsk_title as  title
			,ctsk_notes as  notes
			,ntsk_priority as  priority
			,ntsk_order as  order
			,dtsk_completed as  completed
			,dtsk_duedate as  dueDate
			,dtsk_createdat as  createdAt
			,ctsk_createduser as  createdUser
			,dtsk_updatedat as  updatedAt
			,ctsk_updateduser as  updatedUser
			,ctsk_state as state
		from task.task_tsk a
	</sql>
	
	<select id="selectOneSimple" resultType="TaskDTO">
		<include refid="selectSimpleTaskFragment" />
		<include refid="whereTaskFragment" />
	</select>
	
	<select id="selectManySimple" resultType="TaskDTO">
		<include refid="selectSimpleTaskFragment" />
		<include refid="whereTaskFragment" />
		<include refid="paginationTaskFragment" />
	</select>

</mapper>