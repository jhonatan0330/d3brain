<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.softure.task.infrastructure.TaskTaskMapper">

	<sql id="selectTaskTaskFragment">
		select
			ctsk_llave as  id
			,ctsk_user as user
			,ctsk_title as title
			,ctsk_notes as notes
			,dtsk_completed as completed
			,dtsk_duedate as dueDate
			,ntsk_priority as priority
			,ntsk_order as order
			,dtsk_createdat as  createdAt
			,ctsk_createduser as  createdUser
			,dtsk_updatedat as  updatedAt
			,ctsk_updateduser as  updatedUser
			,ctsk_state as state
		from task.task_tsk a
	</sql>

	<sql id="whereTaskTaskFragment">
		where 1=1
			<if test="id!=null">
				and ctsk_llave = #{id}
			</if>
			<if test="state!=null">
				and ctsk_state = #{state}
			</if>
			<if test="user!=null">
				and ctsk_user = #{user}
			</if>
	</sql>


	<sql id="paginationTaskTaskFragment">
			<if test="endRow!=null">
				LIMIT #{endRow}
			</if>
			<if test="startRow!=null">
				OFFSET #{startRow}
			</if>
	</sql>

	<sql id="whereTaskTaskPrimaryKeyFragment">
		where
			ctsk_llave	=#{id}
	</sql>

	<select id="selectOne" parameterType="TaskTaskDTO" resultType="TaskTaskDTO">
		<include refid="selectTaskTaskFragment" />
		<include refid="whereTaskTaskFragment" />
	</select>
	
	<select id="selectMany" parameterType="TaskTaskDTO" resultType="TaskTaskDTO">
		<include refid="selectTaskTaskFragment" />
		<include refid="whereTaskTaskFragment" />
		order by ntsk_order
		<include refid="paginationTaskTaskFragment" />
	</select>

	<select id="count" parameterType="TaskTaskDTO" resultType="int">
		select count(*)
		from task.task_tsk a
		<include refid="whereTaskTaskFragment" />
	</select>


	<select id="insert" parameterType="TaskTaskDTO" resultType="TaskTaskDTO">
		insert into task.task_tsk(
			ctsk_llave
		<if test="user!=null">
			,ctsk_user
		</if>
		<if test="title!=null">
			,ctsk_title
		</if>
		<if test="notes!=null">
			,ctsk_notes
		</if>
		<if test="completed!=null">
			,dtsk_completed
		</if>
		<if test="dueDate!=null">
			,dtsk_duedate
		</if>
		<if test="priority!=null">
			,ntsk_priority
		</if>
		<if test="order!=null">
			,ntsk_order
		</if>
		<if test="createdAt!=null">
			,dtsk_createdAt
		</if>
		<if test="createdUser!=null">
			,ctsk_createduser
		</if>
		<if test="state!=null">
			,ctsk_state
		</if>
		) values (
			#{id}
		<if test="user!=null">
			,#{user}
		</if>
		<if test="title!=null">
			,#{title}
		</if>
		<if test="notes!=null">
			,#{notes}
		</if>
		<if test="completed!=null">
			,#{completed}
		</if>
		<if test="dueDate!=null">
			,#{dueDate}
		</if>
		<if test="priority!=null">
			,#{priority}
		</if>
		<if test="order!=null">
			,#{order}
		</if>
		<if test="createdAt!=null">
			,#{createdAt}
		</if>
		<if test="createdUser!=null">
			,#{createdUser}
		</if>
		<if test="state!=null">
			,#{state}
		</if>
		)
	</select>

	<select id="update" parameterType="TaskTaskDTO" resultType="TaskTaskDTO">
		update task.task_tsk
			set
				<if test="user!=null">
				ctsk_user = #{user},
				</if>
				<if test="title!=null">
				ctsk_title = #{title},
				</if>
				<if test="notes!=null">
				ctsk_notes = #{notes},
				</if>
				<if test="completed!=null">
				dtsk_completed = #{completed},
				</if>
				<if test="dueDate!=null">
				dtsk_duedate = #{dueDate},
				</if>
				<if test="priority!=null">
				ntsk_priority = #{priority},
				</if>
				<if test="order!=null">
				ntsk_order = #{order},
				</if>
				dtsk_updatedat = #{updatedAt},
				ctsk_updateduser = #{updatedUser},
				ctsk_state =#{state}
		<include refid="whereTaskTaskPrimaryKeyFragment" />
	</select>
	
</mapper>