<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.softure.survey.infrastructure.EncuestaOpcionRespuestaMapper">

	<sql id="selectEncuestaOpcionRespuestaFragment">
		select
			ceor_llave as  llaveTabla
			,ceor_codigo as  codigo
			,ceor_nombre as  nombre
			,ceor_imagen as  imagen
			,ceor_pregunta as  pregunta
			,ceor_estado as estado
		from encuestaopcionrespuesta_eorp a
	</sql>

	<sql id="whereEncuestaOpcionRespuestaFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and ceor_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and ceor_estado = #{estado}
			</if>
			<if test="codigo!=null">
				and ceor_codigo = #{codigo}
			</if>
			<if test="nombre!=null">
				and ceor_nombre = #{nombre}
			</if>
			<if test="pregunta!=null">
				and ceor_pregunta = #{pregunta}
			</if>
	</sql>

	<sql id="paginationEncuestaOpcionRespuestaFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="whereEncuestaOpcionRespuestaPrimaryKeyFragment">
		where
			ceor_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="EncuestaOpcionRespuestaDTO" resultType="EncuestaOpcionRespuestaDTO">
		<include refid="selectEncuestaOpcionRespuestaFragment" />
		<include refid="whereEncuestaOpcionRespuestaFragment" />
	</select>
	
	<select id="listar" parameterType="EncuestaOpcionRespuestaDTO" resultType="EncuestaOpcionRespuestaDTO">
		<include refid="selectEncuestaOpcionRespuestaFragment" />
		<include refid="whereEncuestaOpcionRespuestaFragment" />
		order by ceor_codigo 
		, ceor_nombre 
		<include refid="paginationEncuestaOpcionRespuestaFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="EncuestaOpcionRespuestaDTO" resultType="int">
		select count(*)
		from encuestaopcionrespuesta_eorp
		<include refid="whereEncuestaOpcionRespuestaFragment" />
	</select>


	<select id="insertar" parameterType="EncuestaOpcionRespuestaDTO" resultType="EncuestaOpcionRespuestaDTO">
		insert into encuestaopcionrespuesta_eorp(
			ceor_llave
		<if test="codigo!=null">
			,ceor_codigo
		</if>
		<if test="nombre!=null">
			,ceor_nombre
		</if>
		<if test="imagen!=null">
			,ceor_imagen
		</if>
		<if test="pregunta!=null">
			,ceor_pregunta
		</if>
		<if test="estado!=null">
			,ceor_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="codigo!=null">
			,#{codigo}
		</if>
		<if test="nombre!=null">
			,#{nombre}
		</if>
		<if test="imagen!=null">
			,#{imagen}
		</if>
		<if test="pregunta!=null">
			,#{pregunta}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="EncuestaOpcionRespuestaDTO" resultType="EncuestaOpcionRespuestaDTO">
		update encuestaopcionrespuesta_eorp
			set
				ceor_codigo = #{codigo},
				ceor_nombre = #{nombre},
				ceor_imagen = #{imagen},
				ceor_pregunta = #{pregunta},
				ceor_estado =#{estado}
		<include refid="whereEncuestaOpcionRespuestaPrimaryKeyFragment" />
	</select>
	
	<sql id="selectSimpleEncuestaOpcionRespuestaFragment">
		select
			ceor_llave as  llaveTabla
			,ceor_codigo as  codigo
			,ceor_nombre as  nombre
			,ceor_imagen as  imagen
			,ceor_pregunta as  pregunta
			,ceor_estado as estado
		from encuestaopcionrespuesta_eorp a
	</sql>
	
	<select id="consultarSimple" resultType="EncuestaOpcionRespuestaDTO">
		<include refid="selectSimpleEncuestaOpcionRespuestaFragment" />
		<include refid="whereEncuestaOpcionRespuestaFragment" />
	</select>
	
	<select id="listarSimple" resultType="EncuestaOpcionRespuestaDTO">
		<include refid="selectSimpleEncuestaOpcionRespuestaFragment" />
		<include refid="whereEncuestaOpcionRespuestaFragment" />
		order by ceor_codigo 
		, ceor_nombre 
		<include refid="paginationEncuestaOpcionRespuestaFragment" />
	</select>
	


<!--// BEGIN region script-->
<!--// END region script-->

</mapper>