<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.softure.survey.infrastructure.EncuestaGrupoMapper">

	<sql id="selectEncuestaGrupoFragment">
		select
			cegr_llave as  llaveTabla
			,cegr_codigo as  codigo
			,cegr_nombre as  nombre
			,cegr_encuesta as  encuesta
			,(select count(*) from encuestapregunta_eprp  where cepr_grupo = cegr_llave and cepr_estado = 'A') as  numeroPreguntas
			,(select count(*) from encuestarespuesta_ersp  where cers_estado  ='A' and cers_usuario = #{usuario} and cers_pregunta in (select cepr_llave from encuestapregunta_eprp  where cepr_estado = 'A' and cepr_grupo = cegr_llave )) as  numeroRespuestasUsuario
			,cegr_estado as estado
		from encuestagrupo_egrp a
	</sql>

	<sql id="whereEncuestaGrupoFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and cegr_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and cegr_estado = #{estado}
			</if>
			<if test="codigo!=null">
				and cegr_codigo = #{codigo}
			</if>
			<if test="nombre!=null">
				and cegr_nombre = #{nombre}
			</if>
			<if test="encuesta!=null">
				and cegr_encuesta = #{encuesta}
			</if>
			<if test="filtroParametro!=null">
				and (upper(cegr_nombre) like upper('%' || #{filtroParametro} || '%') or upper(cegr_codigo) like upper('%' || #{filtroParametro} || '%'))
			</if>
	</sql>

	<sql id="paginationEncuestaGrupoFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="whereEncuestaGrupoPrimaryKeyFragment">
		where
			cegr_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="EncuestaGrupoDTO" resultType="EncuestaGrupoDTO">
		<include refid="selectEncuestaGrupoFragment" />
		<include refid="whereEncuestaGrupoFragment" />
	</select>
	
	<select id="listar" parameterType="EncuestaGrupoDTO" resultType="EncuestaGrupoDTO">
		<include refid="selectEncuestaGrupoFragment" />
		<include refid="whereEncuestaGrupoFragment" />
		order by cegr_codigo 
		, cegr_nombre 
		<include refid="paginationEncuestaGrupoFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="EncuestaGrupoDTO" resultType="int">
		select count(*)
		from encuestagrupo_egrp
		<include refid="whereEncuestaGrupoFragment" />
	</select>


	<select id="insertar" parameterType="EncuestaGrupoDTO" resultType="EncuestaGrupoDTO">
		insert into encuestagrupo_egrp(
			cegr_llave
		<if test="codigo!=null">
			,cegr_codigo
		</if>
		<if test="nombre!=null">
			,cegr_nombre
		</if>
		<if test="encuesta!=null">
			,cegr_encuesta
		</if>
		<if test="estado!=null">
			,cegr_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="codigo!=null">
			,#{codigo}
		</if>
		<if test="nombre!=null">
			,#{nombre}
		</if>
		<if test="encuesta!=null">
			,#{encuesta}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="EncuestaGrupoDTO" resultType="EncuestaGrupoDTO">
		update encuestagrupo_egrp
			set
				cegr_codigo = #{codigo},
				cegr_nombre = #{nombre},
				cegr_encuesta = #{encuesta},
				cegr_estado =#{estado}
		<include refid="whereEncuestaGrupoPrimaryKeyFragment" />
	</select>
	
	<sql id="selectSimpleEncuestaGrupoFragment">
		select
			cegr_llave as  llaveTabla
			,cegr_codigo as  codigo
			,cegr_nombre as  nombre
			,cegr_encuesta as  encuesta
			,cegr_estado as estado
		from encuestagrupo_egrp a
	</sql>
	
	<select id="consultarSimple" resultType="EncuestaGrupoDTO">
		<include refid="selectSimpleEncuestaGrupoFragment" />
		<include refid="whereEncuestaGrupoFragment" />
	</select>
	
	<select id="listarSimple" resultType="EncuestaGrupoDTO">
		<include refid="selectSimpleEncuestaGrupoFragment" />
		<include refid="whereEncuestaGrupoFragment" />
		order by cegr_codigo 
		, cegr_nombre 
		<include refid="paginationEncuestaGrupoFragment" />
	</select>
	


<!--// BEGIN region script-->
<!--// END region script-->

</mapper>