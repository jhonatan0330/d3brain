<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.softure.authentication.infrastructure.UsuarioSesionErrorMapper">

	<sql id="selectUsuarioSesionErrorFragment">
		select
			cuse_llave as  llaveTabla
			,cuse_sesion as  sesion
			,cuse_clave as  clave
			,cuse_ip as  ip
			,duse_fecha as  fecha
			,cuse_error as  error
			,cuse_estado as estado
		from usuariosesionerror_usep a
	</sql>

	<sql id="whereUsuarioSesionErrorFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and cuse_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and cuse_estado = #{estado}
			</if>
			<if test="sesion!=null">
				and cuse_sesion = #{sesion}
			</if>
			<if test="clave!=null">
				and cuse_clave = #{clave}
			</if>
			<if test="ip!=null">
				and cuse_ip = #{ip}
			</if>
			<if test="fechaMin!=null">
				and duse_fecha >= #{fechaMin}
			</if>
			<if test="fechaMax!=null">
				and duse_fecha <![CDATA[ < ]]>  #{fechaMax}
			</if>
	</sql>

	<sql id="paginationUsuarioSesionErrorFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="whereUsuarioSesionErrorPrimaryKeyFragment">
		where
			cuse_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="UsuarioSesionErrorDTO" resultType="UsuarioSesionErrorDTO">
		<include refid="selectUsuarioSesionErrorFragment" />
		<include refid="whereUsuarioSesionErrorFragment" />
	</select>
	
	<select id="listar" parameterType="UsuarioSesionErrorDTO" resultType="UsuarioSesionErrorDTO">
		<include refid="selectUsuarioSesionErrorFragment" />
		<include refid="whereUsuarioSesionErrorFragment" />
		<include refid="paginationUsuarioSesionErrorFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="UsuarioSesionErrorDTO" resultType="int">
		select count(*)
		from usuariosesionerror_usep
		<include refid="whereUsuarioSesionErrorFragment" />
	</select>


	<select id="insertar" parameterType="UsuarioSesionErrorDTO" resultType="UsuarioSesionErrorDTO">
		insert into usuariosesionerror_usep(
			cuse_llave
		<if test="sesion!=null">
			,cuse_sesion
		</if>
		<if test="clave!=null">
			,cuse_clave
		</if>
		<if test="ip!=null">
			,cuse_ip
		</if>
		<if test="fecha!=null">
			,duse_fecha
		</if>
		<if test="error!=null">
			,cuse_error
		</if>
		<if test="estado!=null">
			,cuse_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="sesion!=null">
			,#{sesion}
		</if>
		<if test="clave!=null">
			,#{clave}
		</if>
		<if test="ip!=null">
			,#{ip}
		</if>
		<if test="fecha!=null">
			,#{fecha}
		</if>
		<if test="error!=null">
			,#{error}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="UsuarioSesionErrorDTO" resultType="UsuarioSesionErrorDTO">
		update usuariosesionerror_usep
			set
				cuse_sesion = #{sesion},
				cuse_clave = #{clave},
				cuse_ip = #{ip},
				duse_fecha = #{fecha},
				cuse_error = #{error},
				cuse_estado =#{estado}
		<include refid="whereUsuarioSesionErrorPrimaryKeyFragment" />
	</select>
	
	<sql id="selectSimpleUsuarioSesionErrorFragment">
		select
			cuse_llave as  llaveTabla
			,cuse_sesion as  sesion
			,cuse_clave as  clave
			,cuse_ip as  ip
			,duse_fecha as  fecha
			,cuse_error as  error
			,cuse_estado as estado
		from usuariosesionerror_usep a
	</sql>
	
	<select id="consultarSimple" resultType="UsuarioSesionErrorDTO">
		<include refid="selectSimpleUsuarioSesionErrorFragment" />
		<include refid="whereUsuarioSesionErrorFragment" />
	</select>
	
	<select id="listarSimple" resultType="UsuarioSesionErrorDTO">
		<include refid="selectSimpleUsuarioSesionErrorFragment" />
		<include refid="whereUsuarioSesionErrorFragment" />
		<include refid="paginationUsuarioSesionErrorFragment" />
	</select>
	


<!--// BEGIN region script-->
<!--// END region script-->

</mapper>