<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.softure.logisticpymes.infrastructure.CuentaAuxiliarDocumentoMapper">

	<sql id="selectCuentaAuxiliarDocumentoFragment">
		select
			ccad_llave as  llaveTabla
			,ccad_documento as  documento
			,ccad_cuentaauxiliar as  cuentaAuxiliar
			,ccad_estado as estado
		from cuentaauxiliardocumento_cadp a
	</sql>

	<sql id="whereCuentaAuxiliarDocumentoFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and ccad_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and ccad_estado = #{estado}
			</if>
			<if test="documento!=null">
				and ccad_documento = #{documento}
			</if>
			<if test="cuentaAuxiliar!=null">
				and ccad_cuentaauxiliar = #{cuentaAuxiliar}
			</if>
	</sql>

	<sql id="paginationCuentaAuxiliarDocumentoFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="whereCuentaAuxiliarDocumentoPrimaryKeyFragment">
		where
			ccad_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="CuentaAuxiliarDocumentoDTO" resultType="CuentaAuxiliarDocumentoDTO">
		<include refid="selectCuentaAuxiliarDocumentoFragment" />
		<include refid="whereCuentaAuxiliarDocumentoFragment" />
	</select>
	
	<select id="listar" parameterType="CuentaAuxiliarDocumentoDTO" resultType="CuentaAuxiliarDocumentoDTO">
		<include refid="selectCuentaAuxiliarDocumentoFragment" />
		<include refid="whereCuentaAuxiliarDocumentoFragment" />
		<include refid="paginationCuentaAuxiliarDocumentoFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="CuentaAuxiliarDocumentoDTO" resultType="int">
		select count(*)
		from cuentaauxiliardocumento_cadp
		<include refid="whereCuentaAuxiliarDocumentoFragment" />
	</select>


	<select id="insertar" parameterType="CuentaAuxiliarDocumentoDTO" resultType="CuentaAuxiliarDocumentoDTO">
		insert into cuentaauxiliardocumento_cadp(
			ccad_llave
		<if test="documento!=null">
			,ccad_documento
		</if>
		<if test="cuentaAuxiliar!=null">
			,ccad_cuentaauxiliar
		</if>
		<if test="estado!=null">
			,ccad_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="documento!=null">
			,#{documento}
		</if>
		<if test="cuentaAuxiliar!=null">
			,#{cuentaAuxiliar}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="CuentaAuxiliarDocumentoDTO" resultType="CuentaAuxiliarDocumentoDTO">
		update cuentaauxiliardocumento_cadp
			set
				ccad_documento = #{documento},
				ccad_cuentaauxiliar = #{cuentaAuxiliar},
				ccad_estado =#{estado}
		<include refid="whereCuentaAuxiliarDocumentoPrimaryKeyFragment" />
	</select>
	
	<sql id="selectSimpleCuentaAuxiliarDocumentoFragment">
		select
			ccad_llave as  llaveTabla
			,ccad_documento as  documento
			,ccad_cuentaauxiliar as  cuentaAuxiliar
			,ccad_estado as estado
		from cuentaauxiliardocumento_cadp a
	</sql>
	
	<select id="consultarSimple" resultType="CuentaAuxiliarDocumentoDTO">
		<include refid="selectSimpleCuentaAuxiliarDocumentoFragment" />
		<include refid="whereCuentaAuxiliarDocumentoFragment" />
	</select>
	
	<select id="listarSimple" resultType="CuentaAuxiliarDocumentoDTO">
		<include refid="selectSimpleCuentaAuxiliarDocumentoFragment" />
		<include refid="whereCuentaAuxiliarDocumentoFragment" />
		<include refid="paginationCuentaAuxiliarDocumentoFragment" />
	</select>
	


<!--// BEGIN region script-->
<!--// END region script-->

</mapper>