<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.softure.multitenancy.infrastructure.TenantMapper">

	<sql id="selectTenantFragment">
		select
			cten_llave as  key
			,cten_nombre as  name
			,cten_url as  datasourceUrl
			,cten_username as  datasourceUsername
			,cten_password as  datasourcePassword
			,cten_estado as state
		from tenant_ten a
	</sql>

	<sql id="whereTenantFragment">
		where 1=1
			<if test="key!=null">
				and cten_llave = #{key}
			</if>
			<if test="state!=null">
				and cten_estado = #{state}
			</if>
			<if test="name!=null">
				and cten_nombre = #{name}
			</if>
			<if test="datasourceUrl!=null">
				and cten_url = #{datasourceUrl}
			</if>
			<if test="datasourceUsername!=null">
				and cten_username = #{datasourceUsername}
			</if>
			<if test="datasourcePassword!=null">
				and cten_password = #{datasourcePassword}
			</if>
	</sql>

	<sql id="paginationTenantFragment">
		<if test="startRow!=null">OFFSET #{startRow}</if>
		<if test="endRow!=null">LIMIT #{endRow}</if>
	</sql>

	<sql id="whereTenantPrimaryKeyFragment">
		where cten_llave =#{key}
	</sql>

	<select id="getOne" parameterType="TenantFilterDTO" resultType="TenantDTO">
		<include refid="selectTenantFragment" />
		<include refid="whereTenantFragment" />
		LIMIT 2
	</select>
	
	<select id="getMany" parameterType="TenantFilterDTO" resultType="TenantDTO">
		<include refid="selectTenantFragment" />
		<include refid="whereTenantFragment" />
		order by cten_nombre 
		<include refid="paginationTenantFragment" />
	</select>

	<select id="count" parameterType="TenantFilterDTO" resultType="int">
		select count(*)
		from tenant_ten
		<include refid="whereTenantFragment" />
	</select>


	<select id="insert" parameterType="TenantDTO" resultType="TenantDTO">
		insert into tenant_ten(cten_llave
		<if test="name!=null">,cten_nombre</if>
		<if test="datasourceUrl!=null">
			,cten_url
		</if>
		<if test="datasourceUsername!=null">
			,cten_username
		</if>
		<if test="datasourcePassword!=null">
			,cten_password
		</if>
		<if test="state!=null">
			,cten_estado
		</if>
		) values (
			#{key}
		<if test="nombre!=null">
			,#{nombre}
		</if>
		<if test="datasourceUrl!=null">
			,#{datasourceUrl}
		</if>
		<if test="datasourceUsername!=null">
			,#{datasourceUsername}
		</if>
		<if test="datasourcePassword!=null">
			,#{datasourcePassword}
		</if>
		<if test="state!=null">
			,#{state}
		</if>
		)
	</select>

	<select id="update" parameterType="TenantDTO" resultType="TenantDTO">
		update tenant_ten
			set
				cten_nombre = #{name},
				cten_url = #{datasourceUrl},
				cten_username = #{datasourceUsername},
				cten_password = #{datasourcePassword},
				cten_estado =#{state}
		<include refid="whereTenantPrimaryKeyFragment" />
	</select>


</mapper>