<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.learning.helpcenter.infrastructure.ArticleMapper">

	<sql id="selectArticleFragment">
		select
			cart_llave as key
			,cart_titulo as title
			,cart_automatica as automatic
			,cart_entidadTipo as entityType
			,cart_entidadId as entity
			,cart_documento as document
			,cart_imagen as image
			,cart_introduccion as introduction
			,cart_ayuda as help
			,cart_estado as state
		from learning.article_art a
	</sql>

	<sql id="whereArticleFragment">
		where 1=1<if test="key!=null">
		and cart_llave = #{key}</if><if test="state!=null">
		and cart_estado = #{state}</if>
<if test="title!=null">		and cart_titulo = #{title}</if>
<if test="automatic!=null">		and cart_automatica = #{automatic}</if>
<if test="entityType!=null">		and cart_entidadTipo = #{entityType}</if>
<if test="entity!=null">		and cart_entidadId = #{entity}</if>
<if test="document!=null">		and cart_documento = #{document}</if>
<if test="image!=null">		and cart_imagen = #{image}</if>
<if test="introduction!=null">		and cart_introduccion = #{introduction}</if>
<if test="help!=null">		and cart_ayuda = #{help}</if>

	</sql>

	<sql id="paginationArticleFragment">
		<if test="startRow!=null">OFFSET #{startRow}</if>
		<if test="endRow!=null">LIMIT #{endRow}</if>
	</sql>

	<sql id="whereArticlePrimaryKeyFragment">
		where cart_llave =#{key}
	</sql>

	<select id="getOne" parameterType="ArticleFilterDTO" resultType="ArticleDTO">
		<include refid="selectArticleFragment" />
		<include refid="whereArticleFragment" />
		LIMIT 2
	</select>
	
	<select id="getMany" parameterType="ArticleFilterDTO" resultType="ArticleDTO">
		<include refid="selectArticleFragment" />
		<include refid="whereArticleFragment" />
		
		<include refid="paginationArticleFragment" />
	</select>

	<select id="count" parameterType="ArticleFilterDTO" resultType="int">
		select count(*)
		from learning.article_art
		<include refid="whereArticleFragment" />
	</select>

	<select id="insert" parameterType="ArticleDTO" resultType="ArticleDTO">
		insert into learning.article_art(cart_llave
		<if test="title!=null">,cart_titulo</if>
		<if test="automatic!=null">,cart_automatica</if>
		<if test="entityType!=null">,cart_entidadTipo</if>
		<if test="entity!=null">,cart_entidadId</if>
		<if test="document!=null">,cart_documento</if>
		<if test="image!=null">,cart_imagen</if>
		<if test="introduction!=null">,cart_introduccion</if>
		<if test="help!=null">,cart_ayuda</if>
		<if test="state!=null">,cart_estado</if>
		) values (#{key}
		<if test="title!=null">,#{title}</if>
		<if test="automatic!=null">,#{automatic}</if>
		<if test="entityType!=null">,#{entityType}</if>
		<if test="entity!=null">,#{entity}</if>
		<if test="document!=null">,#{document}</if>
		<if test="image!=null">,#{image}</if>
		<if test="introduction!=null">,#{introduction}</if>
		<if test="help!=null">,#{help}</if>
		<if test="state!=null">,#{state}</if>
		)
	</select>

	<select id="update" parameterType="ArticleDTO" resultType="ArticleDTO">
		update learning.article_art
		set
		cart_titulo = #{title},
		cart_automatica = #{automatic},
		cart_entidadTipo = #{entityType},
		cart_entidadId = #{entity},
		cart_documento = #{document},
		cart_imagen = #{image},
		cart_introduccion = #{introduction},
		cart_ayuda = #{help},
		cart_estado =#{state}
		<include refid="whereArticlePrimaryKeyFragment" />
	</select>
	
</mapper>