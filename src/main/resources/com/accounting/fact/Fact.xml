<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.accounting.fact.infrastructure.FactMapper">

	<sql id="selectFactFragment">
		select
			chch_llave as key
			,dhch_fecharegistro as registerDate
			,dhch_fechaevento as factDate
			,chch_dimension as dimension
			,chch_valor as value
			,chch_codigo as code
			,chch_plantilla as template
			,chch_id as id
			,dhch_creacionfecha as createdAt
			,chch_creacionusuario as createdUser
			,chch_creacionusuarionombre as createdUserName
			,dhch_modificacionfecha as updatedAt
			,chch_estado as state
		from account.hecho_hch a
	</sql>

	<sql id="whereFactFragment">
		where 1=1
			<if test="key!=null">
				and chch_llave = #{key}
			</if>
			<if test="state!=null">
				and chch_estado = #{state}
			</if>
			<if test="registerDate!=null">
				and dhch_fecharegistro = #{registerDate}
			</if>
			<if test="factDate!=null">
				and dhch_fechaevento = #{factDate}
			</if>
			<if test="dimension!=null">
				and chch_dimension = #{dimension}
			</if>
			<if test="value!=null">
				and chch_valor = #{value}
			</if>
			<if test="code!=null">
				and chch_codigo = #{code}
			</if>
			<if test="template!=null">
				and chch_plantilla = #{template}
			</if>
			<if test="id!=null">
				and chch_id = #{id}
			</if>

	</sql>

	<sql id="paginationFactFragment">
			<if test="startRow!=null">
				OFFSET #{startRow}
			</if>
			<if test="endRow!=null">
				LIMIT #{endRow}
			</if>
	</sql>

	<sql id="whereFactPrimaryKeyFragment">
		where
			chch_llave =#{key}
	</sql>

	<select id="getOne" parameterType="FactFilterDTO" resultType="FactDTO">
		<include refid="selectFactFragment" />
		<include refid="whereFactFragment" />
	</select>
	
	<select id="getMany" parameterType="FactFilterDTO" resultType="FactDTO">
		<include refid="selectFactFragment" />
		<include refid="whereFactFragment" />
		<include refid="paginationFactFragment" />
	</select>

	<select id="count" parameterType="FactFilterDTO" resultType="int">
		select count(*)
		from account.hecho_hch
		<include refid="whereFactFragment" />
	</select>

	<select id="insert" parameterType="FactDTO" resultType="FactDTO">
		insert into account.hecho_hch(
			chch_llave
			,dhch_creacionfecha
			,dhch_modificacionfecha
		<if test="registerDate!=null">
			,dhch_fecharegistro
		</if>
		<if test="factDate!=null">
			,dhch_fechaevento
		</if>
		<if test="dimension!=null">
			,chch_dimension
		</if>
		<if test="value!=null">
			,chch_valor
		</if>
		<if test="code!=null">
			,chch_codigo
		</if>
		<if test="template!=null">
			,chch_plantilla
		</if>
		<if test="id!=null">
			,chch_id
		</if>
		<if test="createdUser!=null">
			,chch_creacionusuario
		</if>
		<if test="createdUserName!=null">
			,chch_creacionusuarionombre
		</if>
		<if test="state!=null">
			,chch_estado
		</if>
		) values (
			#{key}
			,now()
			,now()
		<if test="registerDate!=null">
			,#{registerDate}
		</if>
		<if test="factDate!=null">
			,#{factDate}
		</if>
		<if test="dimension!=null">
			,#{dimension}
		</if>
		<if test="value!=null">
			,#{value}
		</if>
		<if test="code!=null">
			,#{code}
		</if>
		<if test="template!=null">
			,#{template}
		</if>
		<if test="id!=null">
			,#{id}
		</if>
		<if test="createdUser!=null">
			,#{createdUser}
		</if>
		<if test="createdUserName!=null">
			,#{createdUserName}
		</if>
		<if test="state!=null">
			,#{state}
		</if>
		)
	</select>

	<select id="update" parameterType="FactDTO" resultType="FactDTO">
		update account.hecho_hch
			set
				dhch_modificacionfecha = now(),
				dhch_fecharegistro = #{registerDate},
				dhch_fechaevento = #{factDate},
				chch_dimension = #{dimension},
				chch_valor = #{value},
				chch_codigo = #{code},
				chch_plantilla = #{template},
				chch_id = #{id},
				chch_estado =#{state}
		<include refid="whereFactPrimaryKeyFragment" />
	</select>
	
</mapper>