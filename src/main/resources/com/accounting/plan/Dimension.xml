<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.accounting.plan.infrastructure.DimensionMapper">

	<sql id="selectDimensionFragment">
		select
			cdim_llave as key
			,cdim_cuenta as account
			,cdim_nombre as name
			,cdim_codigo as code
			,cdim_campo as field
			,cdim_tipo as type
			,ddim_creacionfecha as createdAt
			,cdim_creacionusuario as createdUser
			,cdim_creacionusuarionombre as createdUserName
			,ddim_modificacionfecha as updatedAt
			,cdim_estado as state
		from account.dimension_dim a
	</sql>

	<sql id="whereDimensionFragment">
		where 1=1
			<if test="key!=null">
				and cdim_llave = #{key}
			</if>
			<if test="state!=null">
				and cdim_estado = #{state}
			</if>
			<if test="account!=null">
				and cdim_cuenta = #{account}
			</if>
			<if test="name!=null">
				and cdim_nombre = #{name}
			</if>
			<if test="code!=null">
				and cdim_codigo = #{code}
			</if>
			<if test="field!=null">
				and cdim_campo = #{field}
			</if>
			<if test="type!=null">
				and cdim_tipo = #{type}
			</if>

	</sql>

	<sql id="paginationDimensionFragment">
			<if test="startRow!=null">
				OFFSET #{startRow}
			</if>
			<if test="endRow!=null">
				LIMIT #{endRow}
			</if>
	</sql>

	<sql id="whereDimensionPrimaryKeyFragment">
		where
			cdim_llave =#{key}
	</sql>

	<select id="getOne" parameterType="DimensionFilterDTO" resultType="DimensionDTO">
		<include refid="selectDimensionFragment" />
		<include refid="whereDimensionFragment" />
	</select>
	
	<select id="getMany" parameterType="DimensionFilterDTO" resultType="DimensionDTO">
		<include refid="selectDimensionFragment" />
		<include refid="whereDimensionFragment" />
		<include refid="paginationDimensionFragment" />
	</select>

	<select id="count" parameterType="DimensionFilterDTO" resultType="int">
		select count(*)
		from account.dimension_dim
		<include refid="whereDimensionFragment" />
	</select>

	<select id="insert" parameterType="DimensionDTO" resultType="DimensionDTO">
		insert into account.dimension_dim(
			cdim_llave
			,ddim_creacionfecha
			,ddim_modificacionfecha
		<if test="account!=null">
			,cdim_cuenta
		</if>
		<if test="name!=null">
			,cdim_nombre
		</if>
		<if test="code!=null">
			,cdim_codigo
		</if>
		<if test="field!=null">
			,cdim_campo
		</if>
		<if test="type!=null">
			,cdim_tipo
		</if>
		<if test="createdUser!=null">
			,cdim_creacionusuario
		</if>
		<if test="createdUserName!=null">
			,cdim_creacionusuarionombre
		</if>
		<if test="state!=null">
			,cdim_estado
		</if>
		) values (
			#{key}
			,now()
			,now()
		<if test="account!=null">
			,#{account}
		</if>
		<if test="name!=null">
			,#{name}
		</if>
		<if test="code!=null">
			,#{code}
		</if>
		<if test="field!=null">
			,#{field}
		</if>
		<if test="type!=null">
			,#{type}
		</if>
		<if test="createdUser!=null">
			,#{createdUser}
		</if>
		<if test="createdUserName!=null">
			,#{createdUserName}
		</if>
		<if test="state!=null">
			,#{state}
		</if>
		)
	</select>

	<select id="update" parameterType="DimensionDTO" resultType="DimensionDTO">
		update account.dimension_dim
			set
				ddim_modificacionfecha = now(),
				cdim_cuenta = #{account},
				cdim_nombre = #{name},
				cdim_codigo = #{code},
				cdim_campo = #{field},
				cdim_tipo = #{type},
				cdim_estado =#{state}
		<include refid="whereDimensionPrimaryKeyFragment" />
	</select>
	
</mapper>