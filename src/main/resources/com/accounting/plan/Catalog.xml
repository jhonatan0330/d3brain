<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.accounting.plan.infrastructure.CatalogMapper">

	<sql id="selectCatalogFragment">
		select
			cctg_llave as key
			,cctg_nombre as name
			,cctg_codigo as code
			,dctg_fechainicial as initialDate
			,dctg_fechafinal as finalDate
			,cctg_documento as document
			,cctg_plantila as template
			,cctg_estado as state
		from account.catalogo_ctg a
	</sql>

	<sql id="whereCatalogFragment">
		where 1=1<if test="key!=null">
		and cctg_llave = #{key}</if><if test="state!=null">
		and cctg_estado = #{state}</if>
<if test="name!=null">		and cctg_nombre = #{name}</if>
<if test="code!=null">		and cctg_codigo = #{code}</if>
<if test="initialDateMin!=null">		and dctg_fechainicial >= #{initialDateMin}</if><if test="initialDateMax!=null">		and dctg_fechainicial <![CDATA[ < ]]> #{initialDateMax}</if>
<if test="finalDateMin!=null">		and dctg_fechafinal >= #{finalDateMin}</if><if test="finalDateMax!=null">		and dctg_fechafinal <![CDATA[ < ]]> #{finalDateMax}</if>
<if test="document!=null">		and cctg_documento = #{document}</if>
<if test="template!=null">		and cctg_plantila = #{template}</if>

	</sql>

	<sql id="paginationCatalogFragment">
		<if test="startRow!=null">OFFSET #{startRow}</if>
		<if test="endRow!=null">LIMIT #{endRow}</if>
	</sql>

	<sql id="whereCatalogPrimaryKeyFragment">
		where cctg_llave =#{key}
	</sql>

	<select id="getOne" parameterType="CatalogFilterDTO" resultType="CatalogDTO">
		<include refid="selectCatalogFragment" />
		<include refid="whereCatalogFragment" />
		LIMIT 2
	</select>
	
	<select id="getMany" parameterType="CatalogFilterDTO" resultType="CatalogDTO">
		<include refid="selectCatalogFragment" />
		<include refid="whereCatalogFragment" />
		
		<include refid="paginationCatalogFragment" />
	</select>

	<select id="count" parameterType="CatalogFilterDTO" resultType="int">
		select count(*)
		from account.catalogo_ctg
		<include refid="whereCatalogFragment" />
	</select>

	<select id="insert" parameterType="CatalogDTO" resultType="CatalogDTO">
		insert into account.catalogo_ctg(cctg_llave
		<if test="name!=null">,cctg_nombre</if>
		<if test="code!=null">,cctg_codigo</if>
		<if test="initialDate!=null">,dctg_fechainicial</if>
		<if test="finalDate!=null">,dctg_fechafinal</if>
		<if test="document!=null">,cctg_documento</if>
		<if test="template!=null">,cctg_plantila</if>
		<if test="state!=null">,cctg_estado</if>
		) values (#{key}
		<if test="name!=null">,#{name}</if>
		<if test="code!=null">,#{code}</if>
		<if test="initialDate!=null">,#{initialDate}</if>
		<if test="finalDate!=null">,#{finalDate}</if>
		<if test="document!=null">,#{document}</if>
		<if test="template!=null">,#{template}</if>
		<if test="state!=null">,#{state}</if>
		)
	</select>

	<select id="update" parameterType="CatalogDTO" resultType="CatalogDTO">
		update account.catalogo_ctg
		set
		cctg_nombre = #{name},
		cctg_codigo = #{code},
		dctg_fechainicial = #{initialDate},
		dctg_fechafinal = #{finalDate},
		cctg_documento = #{document},
		cctg_plantila = #{template},
		cctg_estado =#{state}
		<include refid="whereCatalogPrimaryKeyFragment" />
	</select>
	
</mapper>