<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.accounting.plan.infrastructure.CuentaMapper">

	<sql id="selectCuentaFragment">
		select
			ccta_llave as  llaveTabla
			,ccta_codigo as  codigo
			,ccta_nombre as  nombre
			,mcta_sobregiro as  sobregiro
			,ccta_catalogo as  catalogo
			,ccta_cuentapadre as  cuentaPadre
			,ccta_estado as estado
		from cuenta_ctap a
	</sql>

	<sql id="whereCuentaFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and ccta_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and ccta_estado = #{estado}
			</if>
			<if test="codigo!=null">
				and ccta_codigo = #{codigo}
			</if>
			<if test="nombre!=null">
				and ccta_nombre = #{nombre}
			</if>
			<if test="catalogo!=null">
				and ccta_catalogo = #{catalogo}
			</if>
			<if test="cuentaPadre!=null">
				and ccta_cuentapadre = #{cuentaPadre}
			</if>
	</sql>

	<sql id="paginationCuentaFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="whereCuentaPrimaryKeyFragment">
		where
			ccta_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="CuentaDTO" resultType="CuentaDTO">
		<include refid="selectCuentaFragment" />
		<include refid="whereCuentaFragment" />
	</select>
	
	<select id="listar" parameterType="CuentaDTO" resultType="CuentaDTO">
		<include refid="selectCuentaFragment" />
		<include refid="whereCuentaFragment" />
		<include refid="paginationCuentaFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="CuentaDTO" resultType="int">
		select count(*)
		from cuenta_ctap
		<include refid="whereCuentaFragment" />
	</select>


	<select id="insertar" parameterType="CuentaDTO" resultType="CuentaDTO">
		insert into Cuenta_ctap(
			ccta_llave
		<if test="codigo!=null">
			,ccta_codigo
		</if>
		<if test="nombre!=null">
			,ccta_nombre
		</if>
		<if test="sobregiro!=null">
			,mcta_sobregiro
		</if>
		<if test="catalogo!=null">
			,ccta_catalogo
		</if>
		<if test="cuentaPadre!=null">
			,ccta_cuentapadre
		</if>
		<if test="estado!=null">
			,ccta_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="codigo!=null">
			,#{codigo}
		</if>
		<if test="nombre!=null">
			,#{nombre}
		</if>
		<if test="sobregiro!=null">
			,#{sobregiro}
		</if>
		<if test="catalogo!=null">
			,#{catalogo}
		</if>
		<if test="cuentaPadre!=null">
			,#{cuentaPadre}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="CuentaDTO" resultType="CuentaDTO">
		update Cuenta_ctap
			set
				ccta_codigo = #{codigo},
				ccta_nombre = #{nombre},
				mcta_sobregiro = #{sobregiro},
				ccta_catalogo = #{catalogo},
				ccta_cuentapadre = #{cuentaPadre},
				ccta_estado =#{estado}
		<include refid="whereCuentaPrimaryKeyFragment" />
	</select>
	
	<sql id="selectSimpleCuentaFragment">
		select
			ccta_llave as  llaveTabla
			,ccta_codigo as  codigo
			,ccta_nombre as  nombre
			,mcta_sobregiro as  sobregiro
			,ccta_catalogo as  catalogo
			,ccta_cuentapadre as  cuentaPadre
			,ccta_estado as estado
		from cuenta_ctap a
	</sql>
	
	<select id="consultarSimple" resultType="CuentaDTO">
		<include refid="selectSimpleCuentaFragment" />
		<include refid="whereCuentaFragment" />
	</select>
	
	<select id="listarSimple" resultType="CuentaDTO">
		<include refid="selectSimpleCuentaFragment" />
		<include refid="whereCuentaFragment" />
		<include refid="paginationCuentaFragment" />
	</select>
	


<!--// BEGIN region script-->
<!--// END region script-->

</mapper>