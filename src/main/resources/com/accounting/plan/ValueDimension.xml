<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.accounting.plan.infrastructure.ValueDimensionMapper">

	<sql id="selectValueDimensionFragment">
		select
			cvlr_llave as key
			,cvlr_dimension as dimension
			,cvlr_valor as value
			,cvlr_codigo as code
			,cvlr_plantilla as template
			,cvlr_estado as state
		from valor_vlr a
	</sql>

	<sql id="whereValueDimensionFragment">
		where 1=1
			<if test="key!=null">
				and cvlr_llave = #{key}
			</if>
			<if test="state!=null">
				and cvlr_estado = #{state}
			</if>
			<if test="dimension!=null">
				and cvlr_dimension = #{dimension}
			</if>
			<if test="value!=null">
				and cvlr_valor = #{value}
			</if>
			<if test="code!=null">
				and cvlr_codigo = #{code}
			</if>
			<if test="template!=null">
				and cvlr_plantilla = #{template}
			</if>

	</sql>

	<sql id="paginationValueDimensionFragment">
			<if test="indexStart!=null">
				OFFSET #{indexStart}
			</if>
			<if test="indexEnd!=null">
				LIMIT #{indexEnd}
			</if>
	</sql>

	<sql id="whereValueDimensionPrimaryKeyFragment">
		where
			cvlr_llave =#{key}
	</sql>

	<select id="getOne" parameterType="ValueDimensionFilterDTO" resultType="ValueDimensionDTO">
		<include refid="selectValueDimensionFragment" />
		<include refid="whereValueDimensionFragment" />
	</select>
	
	<select id="getMany" parameterType="ValueDimensionFilterDTO" resultType="ValueDimensionDTO">
		<include refid="selectValueDimensionFragment" />
		<include refid="whereValueDimensionFragment" />
		<include refid="paginationValueDimensionFragment" />
	</select>

	<select id="count" parameterType="ValueDimensionFilterDTO" resultType="int">
		select count(*)
		from valor_vlr
		<include refid="whereValueDimensionFragment" />
	</select>

	<select id="insert" parameterType="ValueDimensionDTO" resultType="ValueDimensionDTO">
		insert into valor_vlr(
			cvlr_llave
		<if test="dimension!=null">
			,cvlr_dimension
		</if>
		<if test="value!=null">
			,cvlr_valor
		</if>
		<if test="code!=null">
			,cvlr_codigo
		</if>
		<if test="template!=null">
			,cvlr_plantilla
		</if>
		<if test="state!=null">
			,cvlr_estado
		</if>
		) values (
			#{key}
		<if test="dimension!=null">
			,#{dimension}
		</if>
		<if test="value!=null">
			,#{value}
		</if>
		<if test="code!=null">
			,#{code}
		</if>
		<if test="template!=null">
			,#{template}
		</if>
		<if test="state!=null">
			,#{state}
		</if>
		)
	</select>

	<select id="update" parameterType="ValueDimensionDTO" resultType="ValueDimensionDTO">
		update valor_vlr
			set
				cvlr_dimension = #{dimension},
				cvlr_valor = #{value},
				cvlr_codigo = #{code},
				cvlr_plantilla = #{template},
				cvlr_estado =#{state}
		<include refid="whereValueDimensionPrimaryKeyFragment" />
	</select>
	
</mapper>