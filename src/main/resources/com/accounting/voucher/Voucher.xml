<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.accounting.voucher.infrastructure.VoucherMapper">

	<sql id="selectVoucherFragment">
		select
			ccmp_llave as key
			,ccmp_catalogo as catalog
			,ccmp_codigo as code
			,ccmp_tipo as type
			,ccmp_concepto as concept
			,dcmp_fechacomprobante as factDate
			,mcmp_valor as value
			,ccmp_documento as document
			,dcmp_fechaanulacion as deleteDate
			,dcmp_creacionfecha as creationDate
			,ccmp_estado as state
		from account.comprobante_cmp a
	</sql>

	<sql id="whereVoucherFragment">
		where 1=1<if test="key!=null">
		and ccmp_llave = #{key}</if><if test="state!=null">
		and ccmp_estado = #{state}</if>
<if test="catalog!=null">		and ccmp_catalogo = #{catalog}</if>
<if test="code!=null">		and ccmp_codigo = #{code}</if>
<if test="type!=null">		and ccmp_tipo = #{type}</if>
<if test="concept!=null">		and ccmp_concepto = #{concept}</if>
<if test="factDateMin!=null">		and dcmp_fechacomprobante >= #{factDateMin}</if><if test="factDateMax!=null">		and dcmp_fechacomprobante <![CDATA[ < ]]> #{factDateMax}</if>
<if test="value!=null">		and mcmp_valor = #{value}</if>
<if test="document!=null">		and ccmp_documento = #{document}</if>
<if test="deleteDateMin!=null">		and dcmp_fechaanulacion >= #{deleteDateMin}</if><if test="deleteDateMax!=null">		and dcmp_fechaanulacion <![CDATA[ < ]]> #{deleteDateMax}</if>
<if test="creationDateMin!=null">		and dcmp_creacionfecha >= #{creationDateMin}</if><if test="creationDateMax!=null">		and dcmp_creacionfecha <![CDATA[ < ]]> #{creationDateMax}</if>

	</sql>

	<sql id="paginationVoucherFragment">
		<if test="startRow!=null">OFFSET #{startRow}</if>
		<if test="endRow!=null">LIMIT #{endRow}</if>
	</sql>

	<sql id="whereVoucherPrimaryKeyFragment">
		where ccmp_llave =#{key}
	</sql>

	<select id="getOne" parameterType="VoucherFilterDTO" resultType="VoucherDTO">
		<include refid="selectVoucherFragment" />
		<include refid="whereVoucherFragment" />
		LIMIT 2
	</select>
	
	<select id="getMany" parameterType="VoucherFilterDTO" resultType="VoucherDTO">
		<include refid="selectVoucherFragment" />
		<include refid="whereVoucherFragment" />
		order by factDate desc 
		<include refid="paginationVoucherFragment" />
	</select>

	<select id="count" parameterType="VoucherFilterDTO" resultType="int">
		select count(*)
		from account.comprobante_cmp
		<include refid="whereVoucherFragment" />
	</select>

	<select id="insert" parameterType="VoucherDTO" resultType="VoucherDTO">
		insert into account.comprobante_cmp(ccmp_llave
		<if test="catalog!=null">,ccmp_catalogo</if>
		<if test="code!=null">,ccmp_codigo</if>
		<if test="type!=null">,ccmp_tipo</if>
		<if test="concept!=null">,ccmp_concepto</if>
		<if test="factDate!=null">,dcmp_fechacomprobante</if>
		<if test="value!=null">,mcmp_valor</if>
		<if test="document!=null">,ccmp_documento</if>
		<if test="deleteDate!=null">,dcmp_fechaanulacion</if>
		<if test="creationDate!=null">,dcmp_creacionfecha</if>
		<if test="state!=null">,ccmp_estado</if>
		) values (#{key}
		<if test="catalog!=null">,#{catalog}</if>
		<if test="code!=null">,#{code}</if>
		<if test="type!=null">,#{type}</if>
		<if test="concept!=null">,#{concept}</if>
		<if test="factDate!=null">,#{factDate}</if>
		<if test="value!=null">,#{value}</if>
		<if test="document!=null">,#{document}</if>
		<if test="deleteDate!=null">,#{deleteDate}</if>
		<if test="creationDate!=null">,#{creationDate}</if>
		<if test="state!=null">,#{state}</if>
		)
	</select>

	<select id="update" parameterType="VoucherDTO" resultType="VoucherDTO">
		update account.comprobante_cmp
		set
		ccmp_catalogo = #{catalog},
		ccmp_codigo = #{code},
		ccmp_tipo = #{type},
		ccmp_concepto = #{concept},
		dcmp_fechacomprobante = #{factDate},
		mcmp_valor = #{value},
		ccmp_documento = #{document},
		dcmp_fechaanulacion = #{deleteDate},
		dcmp_creacionfecha = #{creationDate},
		ccmp_estado =#{state}
		<include refid="whereVoucherPrimaryKeyFragment" />
	</select>
	
</mapper>