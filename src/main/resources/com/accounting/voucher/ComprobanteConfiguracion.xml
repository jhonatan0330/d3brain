<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.accounting.voucher.infrastructure.ComprobanteConfiguracionMapper">

	<sql id="selectComprobanteConfiguracionFragment">
		select
			ccnf_llave as  llaveTabla
			,ccnf_plantilla as  plantilla
			,ccnf_catalogo as  catalogo
			,ccnf_estado as estado
		from comprobanteconfiguracion_cnfp a
	</sql>

	<sql id="whereComprobanteConfiguracionFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and ccnf_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and ccnf_estado = #{estado}
			</if>
			<if test="plantilla!=null">
				and ccnf_plantilla = #{plantilla}
			</if>
			<if test="catalogo!=null">
				and ccnf_catalogo = #{catalogo}
			</if>
	</sql>

	<sql id="paginationComprobanteConfiguracionFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="whereComprobanteConfiguracionPrimaryKeyFragment">
		where
			ccnf_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="ComprobanteConfiguracionDTO" resultType="ComprobanteConfiguracionDTO">
		<include refid="selectComprobanteConfiguracionFragment" />
		<include refid="whereComprobanteConfiguracionFragment" />
	</select>
	
	<select id="listar" parameterType="ComprobanteConfiguracionDTO" resultType="ComprobanteConfiguracionDTO">
		<include refid="selectComprobanteConfiguracionFragment" />
		<include refid="whereComprobanteConfiguracionFragment" />
		<include refid="paginationComprobanteConfiguracionFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="ComprobanteConfiguracionDTO" resultType="int">
		select count(*)
		from comprobanteconfiguracion_cnfp
		<include refid="whereComprobanteConfiguracionFragment" />
	</select>


	<select id="insertar" parameterType="ComprobanteConfiguracionDTO" resultType="ComprobanteConfiguracionDTO">
		insert into comprobanteconfiguracion_cnfp(
			ccnf_llave
		<if test="plantilla!=null">
			,ccnf_plantilla
		</if>
		<if test="catalogo!=null">
			,ccnf_catalogo
		</if>
		<if test="estado!=null">
			,ccnf_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="plantilla!=null">
			,#{plantilla}
		</if>
		<if test="catalogo!=null">
			,#{catalogo}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="ComprobanteConfiguracionDTO" resultType="ComprobanteConfiguracionDTO">
		update comprobanteconfiguracion_cnfp
			set
				ccnf_plantilla = #{plantilla},
				ccnf_catalogo = #{catalogo},
				ccnf_estado =#{estado}
		<include refid="whereComprobanteConfiguracionPrimaryKeyFragment" />
	</select>
	
	<sql id="selectSimpleComprobanteConfiguracionFragment">
		select
			ccnf_llave as  llaveTabla
			,ccnf_plantilla as  plantilla
			,ccnf_catalogo as  catalogo
			,ccnf_estado as estado
		from comprobanteconfiguracion_cnfp a
	</sql>
	
	<select id="consultarSimple" resultType="ComprobanteConfiguracionDTO">
		<include refid="selectSimpleComprobanteConfiguracionFragment" />
		<include refid="whereComprobanteConfiguracionFragment" />
	</select>
	
	<select id="listarSimple" resultType="ComprobanteConfiguracionDTO">
		<include refid="selectSimpleComprobanteConfiguracionFragment" />
		<include refid="whereComprobanteConfiguracionFragment" />
		<include refid="paginationComprobanteConfiguracionFragment" />
	</select>
	


<!--// BEGIN region script-->
<!--// END region script-->

</mapper>