<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.accounting.voucher.infrastructure.ComprobanteConfiguracionDetalleMapper">

	<sql id="selectComprobanteConfiguracionDetalleFragment">
		select
			cccd_llave as  llaveTabla
			,cccd_configuracion as  configuracion
			,cccd_cuenta as  cuenta
			,cccd_valordebe as  valorDebe
			,cccd_valorhaber as  valorHaber
			,cccd_estado as estado
		from comprobanteconfiguraciondetalle_ccdp a
	</sql>

	<sql id="whereComprobanteConfiguracionDetalleFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and cccd_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and cccd_estado = #{estado}
			</if>
			<if test="configuracion!=null">
				and cccd_configuracion = #{configuracion}
			</if>
			<if test="cuenta!=null">
				and cccd_cuenta = #{cuenta}
			</if>
			<if test="valorDebe!=null">
				and cccd_valordebe = #{valorDebe}
			</if>
			<if test="valorHaber!=null">
				and cccd_valorhaber = #{valorHaber}
			</if>
	</sql>

	<sql id="paginationComprobanteConfiguracionDetalleFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="whereComprobanteConfiguracionDetallePrimaryKeyFragment">
		where
			cccd_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="ComprobanteConfiguracionDetalleDTO" resultType="ComprobanteConfiguracionDetalleDTO">
		<include refid="selectComprobanteConfiguracionDetalleFragment" />
		<include refid="whereComprobanteConfiguracionDetalleFragment" />
	</select>
	
	<select id="listar" parameterType="ComprobanteConfiguracionDetalleDTO" resultType="ComprobanteConfiguracionDetalleDTO">
		<include refid="selectComprobanteConfiguracionDetalleFragment" />
		<include refid="whereComprobanteConfiguracionDetalleFragment" />
		<include refid="paginationComprobanteConfiguracionDetalleFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="ComprobanteConfiguracionDetalleDTO" resultType="int">
		select count(*)
		from comprobanteconfiguraciondetalle_ccdp
		<include refid="whereComprobanteConfiguracionDetalleFragment" />
	</select>


	<select id="insertar" parameterType="ComprobanteConfiguracionDetalleDTO" resultType="ComprobanteConfiguracionDetalleDTO">
		insert into comprobanteconfiguraciondetalle_ccdp(
			cccd_llave
		<if test="configuracion!=null">
			,cccd_configuracion
		</if>
		<if test="cuenta!=null">
			,cccd_cuenta
		</if>
		<if test="valorDebe!=null">
			,cccd_valordebe
		</if>
		<if test="valorHaber!=null">
			,cccd_valorhaber
		</if>
		<if test="estado!=null">
			,cccd_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="configuracion!=null">
			,#{configuracion}
		</if>
		<if test="cuenta!=null">
			,#{cuenta}
		</if>
		<if test="valorDebe!=null">
			,#{valorDebe}
		</if>
		<if test="valorHaber!=null">
			,#{valorHaber}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="ComprobanteConfiguracionDetalleDTO" resultType="ComprobanteConfiguracionDetalleDTO">
		update comprobanteconfiguraciondetalle_ccdp
			set
				cccd_configuracion = #{configuracion},
				cccd_cuenta = #{cuenta},
				cccd_valordebe = #{valorDebe},
				cccd_valorhaber = #{valorHaber},
				cccd_estado =#{estado}
		<include refid="whereComprobanteConfiguracionDetallePrimaryKeyFragment" />
	</select>
	
	<sql id="selectSimpleComprobanteConfiguracionDetalleFragment">
		select
			cccd_llave as  llaveTabla
			,cccd_configuracion as  configuracion
			,cccd_cuenta as  cuenta
			,cccd_valordebe as  valorDebe
			,cccd_valorhaber as  valorHaber
			,cccd_estado as estado
		from comprobanteconfiguraciondetalle_ccdp a
	</sql>
	
	<select id="consultarSimple" resultType="ComprobanteConfiguracionDetalleDTO">
		<include refid="selectSimpleComprobanteConfiguracionDetalleFragment" />
		<include refid="whereComprobanteConfiguracionDetalleFragment" />
	</select>
	
	<select id="listarSimple" resultType="ComprobanteConfiguracionDetalleDTO">
		<include refid="selectSimpleComprobanteConfiguracionDetalleFragment" />
		<include refid="whereComprobanteConfiguracionDetalleFragment" />
		<include refid="paginationComprobanteConfiguracionDetalleFragment" />
	</select>
	


<!--// BEGIN region script-->
<!--// END region script-->

</mapper>