<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.accounting.voucher.infrastructure.AccountRecordMapper">

	<sql id="selectAccountRecordFragment">
		select
			creg_llave as key
			,creg_comprobante as voucher
			,creg_cuenta as account
			,creg_codigo as code
			,creg_descripcion as note
			,dreg_fecha as factDate
			,mreg_positivo as positive
			,mreg_negativo as negative
			,mreg_valor as value
			,creg_tercero as third
			,creg_terceroid as thirdId
			,creg_terceronombre as thirdName
			,dreg_creacionfecha as createdAt
			,creg_creacionusuario as createdUser
			,creg_creacionusuarionombre as createdUserName
			,dreg_modificacionfecha as updatedAt
			,creg_estado as state
		from x_${catalogCode}_registro_reg a
	</sql>

	<sql id="whereAccountRecordFragment">
		where 1=1
			<if test="key!=null">
				and creg_llave = #{key}
			</if>
			<if test="state!=null">
				and creg_estado = #{state}
			</if>
			<if test="voucher!=null">
				and creg_comprobante = #{voucher}
			</if>
			<if test="account!=null">
				and creg_cuenta = #{account}
			</if>
			<if test="code!=null">
				and creg_codigo = #{code}
			</if>
			<if test="note!=null">
				and creg_descripcion = #{note}
			</if>
			<if test="factDate!=null">
				and dreg_fecha = #{factDate}
			</if>
			<if test="positive!=null">
				and mreg_positivo = #{positive}
			</if>
			<if test="negative!=null">
				and mreg_negativo = #{negative}
			</if>
			<if test="value!=null">
				and mreg_valor = #{value}
			</if>
			<if test="third!=null">
				and creg_tercero = #{third}
			</if>
			<if test="thirdId!=null">
				and creg_terceroid = #{thirdId}
			</if>
			<if test="thirdName!=null">
				and creg_terceronombre = #{thirdName}
			</if>

	</sql>

	<sql id="paginationAccountRecordFragment">
			<if test="startRow!=null">
				OFFSET #{startRow}
			</if>
			<if test="endRow!=null">
				LIMIT #{endRow}
			</if>
	</sql>

	<sql id="whereAccountRecordPrimaryKeyFragment">
		where
			creg_llave =#{key}
	</sql>

	<select id="getOne" parameterType="AccountRecordFilterDTO" resultType="AccountRecordDTO">
		<include refid="selectAccountRecordFragment" />
		<include refid="whereAccountRecordFragment" />
	</select>
	
	<select id="getMany" parameterType="AccountRecordFilterDTO" resultType="AccountRecordDTO">
		<include refid="selectAccountRecordFragment" />
		<include refid="whereAccountRecordFragment" />
		<include refid="paginationAccountRecordFragment" />
	</select>

	<select id="count" parameterType="AccountRecordFilterDTO" resultType="int">
		select count(*)
		from x_${catalogCode}_registro_reg
		<include refid="whereAccountRecordFragment" />
	</select>

	<select id="insert" parameterType="AccountRecordDTO" resultType="AccountRecordDTO">
		insert into x_${catalogCode}_registro_reg(
			creg_llave
			,dreg_creacionfecha
		<if test="voucher!=null">
			,creg_comprobante
		</if>
		<if test="account!=null">
			,creg_cuenta
		</if>
		<if test="code!=null">
			,creg_codigo
		</if>
		<if test="note!=null">
			,creg_descripcion
		</if>
		<if test="factDate!=null">
			,dreg_fecha
		</if>
		<if test="positive!=null">
			,mreg_positivo
		</if>
		<if test="negative!=null">
			,mreg_negativo
		</if>
		<if test="value!=null">
			,mreg_valor
		</if>
		<if test="third!=null">
			,creg_tercero
		</if>
		<if test="thirdId!=null">
			,creg_terceroid
		</if>
		<if test="thirdName!=null">
			,creg_terceronombre
		</if>
		<if test="createdUser!=null">
			,creg_creacionusuario
		</if>
		<if test="createdUserName!=null">
			,creg_creacionusuarionombre
		</if>
		<if test="state!=null">
			,creg_estado
		</if>
		) values (
			#{key}
			,now()
		<if test="voucher!=null">
			,#{voucher}
		</if>
		<if test="account!=null">
			,#{account}
		</if>
		<if test="code!=null">
			,#{code}
		</if>
		<if test="note!=null">
			,#{note}
		</if>
		<if test="factDate!=null">
			,#{factDate}
		</if>
		<if test="positive!=null">
			,#{positive}
		</if>
		<if test="negative!=null">
			,#{negative}
		</if>
		<if test="value!=null">
			,#{value}
		</if>
		<if test="third!=null">
			,#{third}
		</if>
		<if test="thirdId!=null">
			,#{thirdId}
		</if>
		<if test="thirdName!=null">
			,#{thirdName}
		</if>
		<if test="createdUser!=null">
			,#{createdUser}
		</if>
		<if test="createdUserName!=null">
			,#{createdUserName}
		</if>
		<if test="state!=null">
			,#{state}
		</if>
		)
	</select>

	<select id="update" parameterType="AccountRecordDTO" resultType="AccountRecordDTO">
		update x_${catalogCode}_registro_reg
			set
				dreg_modificacionfecha = now(),
				creg_comprobante = #{voucher},
				creg_cuenta = #{account},
				creg_codigo = #{code},
				creg_descripcion = #{note},
				dreg_fecha = #{factDate},
				mreg_positivo = #{positive},
				mreg_negativo = #{negative},
				mreg_valor = #{value},
				creg_tercero = #{third},
				creg_terceroid = #{thirdId},
				creg_terceronombre = #{thirdName},
				creg_estado =#{state}
		<include refid="whereAccountRecordPrimaryKeyFragment" />
	</select>
	
</mapper>