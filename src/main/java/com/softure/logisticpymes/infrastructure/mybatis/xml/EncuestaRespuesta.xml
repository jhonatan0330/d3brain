<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.softure.logisticpymes.infrastructure.mybatis.mapper.EncuestaRespuestaMapper">

	<sql id="selectEncuestaRespuestaFragment">
		select
			cers_llave as  llaveTabla
			,cers_pregunta as  pregunta
			,ders_fecha as  fecha
			,cers_usuario as  usuario
			,bers_respuestaboolean as  respuestaBoolean
			,cers_respuestaopcion as  respuestaOpcion
			,cers_comentario as  comentario
			,cers_estado as estado
		from encuestarespuesta_ersp a
	</sql>

	<sql id="whereEncuestaRespuestaFragment">
		where 1=1
			<if test="llaveTabla!=null">
				and cers_llave = #{llaveTabla}
			</if>
			<if test="estado!=null">
				and cers_estado = #{estado}
			</if>
			<if test="pregunta!=null">
				and cers_pregunta = #{pregunta}
			</if>
			<if test="fechaMin!=null">
				and ders_fecha >= #{fechaMin}
			</if>
			<if test="fechaMax!=null">
				and ders_fecha <![CDATA[ < ]]>  #{fechaMax}
			</if>
			<if test="usuario!=null">
				and cers_usuario = #{usuario}
			</if>
			<if test="respuestaBooleanFilter!=null">
				and bers_respuestaboolean = #{respuestaBooleanFilter}
			</if>
			<if test="respuestaOpcion!=null">
				and cers_respuestaopcion = #{respuestaOpcion}
			</if>
	</sql>

	<sql id="paginationEncuestaRespuestaFragment">
			<if test="paginacionRegistroFinal!=null">
				LIMIT #{paginacionRegistroFinal}
			</if>
			<if test="paginacionRegistroInicial!=null">
				OFFSET #{paginacionRegistroInicial}
			</if>
	</sql>

	<sql id="whereEncuestaRespuestaPrimaryKeyFragment">
		where
			cers_llave	=#{llaveTabla}
	</sql>

	<select id="consultar" parameterType="EncuestaRespuestaDTO" resultType="EncuestaRespuestaDTO">
		<include refid="selectEncuestaRespuestaFragment" />
		<include refid="whereEncuestaRespuestaFragment" />
	</select>
	
	<select id="listar" parameterType="EncuestaRespuestaDTO" resultType="EncuestaRespuestaDTO">
		<include refid="selectEncuestaRespuestaFragment" />
		<include refid="whereEncuestaRespuestaFragment" />
		<include refid="paginationEncuestaRespuestaFragment" />
	</select>

	<select id="cantidadRegistros" parameterType="EncuestaRespuestaDTO" resultType="int">
		select count(*)
		from encuestarespuesta_ersp
		<include refid="whereEncuestaRespuestaFragment" />
	</select>


	<select id="insertar" parameterType="EncuestaRespuestaDTO" resultType="EncuestaRespuestaDTO">
		insert into encuestarespuesta_ersp(
			cers_llave
		<if test="pregunta!=null">
			,cers_pregunta
		</if>
		<if test="fecha!=null">
			,ders_fecha
		</if>
		<if test="usuario!=null">
			,cers_usuario
		</if>
		<if test="respuestaBoolean!=null">
			,bers_respuestaboolean
		</if>
		<if test="respuestaOpcion!=null">
			,cers_respuestaopcion
		</if>
		<if test="comentario!=null">
			,cers_comentario
		</if>
		<if test="estado!=null">
			,cers_estado
		</if>
		) values (
			#{llaveTabla}
		<if test="pregunta!=null">
			,#{pregunta}
		</if>
		<if test="fecha!=null">
			,#{fecha}
		</if>
		<if test="usuario!=null">
			,#{usuario}
		</if>
		<if test="respuestaBoolean!=null">
			,#{respuestaBoolean}
		</if>
		<if test="respuestaOpcion!=null">
			,#{respuestaOpcion}
		</if>
		<if test="comentario!=null">
			,#{comentario}
		</if>
		<if test="estado!=null">
			,#{estado}
		</if>
		)
	</select>

	<select id="actualizar" parameterType="EncuestaRespuestaDTO" resultType="EncuestaRespuestaDTO">
		update encuestarespuesta_ersp
			set
				cers_pregunta = #{pregunta},
				ders_fecha = #{fecha},
				cers_usuario = #{usuario},
				bers_respuestaboolean = #{respuestaBoolean},
				cers_respuestaopcion = #{respuestaOpcion},
				cers_comentario = #{comentario},
				cers_estado =#{estado}
		<include refid="whereEncuestaRespuestaPrimaryKeyFragment" />
	</select>
	
	<sql id="selectSimpleEncuestaRespuestaFragment">
		select
			cers_llave as  llaveTabla
			,cers_pregunta as  pregunta
			,ders_fecha as  fecha
			,cers_usuario as  usuario
			,bers_respuestaboolean as  respuestaBoolean
			,cers_respuestaopcion as  respuestaOpcion
			,cers_comentario as  comentario
			,cers_estado as estado
		from encuestarespuesta_ersp a
	</sql>
	
	<select id="consultarSimple" resultType="EncuestaRespuestaDTO">
		<include refid="selectSimpleEncuestaRespuestaFragment" />
		<include refid="whereEncuestaRespuestaFragment" />
	</select>
	
	<select id="listarSimple" resultType="EncuestaRespuestaDTO">
		<include refid="selectSimpleEncuestaRespuestaFragment" />
		<include refid="whereEncuestaRespuestaFragment" />
		<include refid="paginationEncuestaRespuestaFragment" />
	</select>
	


<!--// BEGIN region script-->
<!--// END region script-->

</mapper>